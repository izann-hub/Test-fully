--[[
    PremiumUI + Font Changer + Optimizer (ALL-IN-ONE)
    Parent: StarterPlayer > StarterPlayerScripts
    Nama: PremiumUI_Optimizer
    Fungsi: UI premium, font changer, hover, animasi masuk, optimize performa.
]]

-- ============================================================
-- SERVICES
-- ============================================================
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local player = Players.LocalPlayer

-- ============================================================
-- TAKARAN
-- ============================================================
local ACCENT = Color3.fromRGB(120, 80, 255)
local BG_TOP = Color3.fromRGB(30, 30, 45)
local BG_BOT = Color3.fromRGB(15, 15, 25)
local TEXT_C = Color3.fromRGB(235, 235, 245)

local MAX_DISTANCE = 300
local MIN_PART_SIZE = 0.5
local CULL_INTERVAL = 2

-- ============================================================
-- FONT LIST
-- ============================================================
local FONTS = {
    Enum.Font.Gotham, Enum.Font.GothamBold, Enum.Font.GothamBlack,
    Enum.Font.SourceSans, Enum.Font.SourceSansBold, Enum.Font.SourceSansLight,
    Enum.Font.Code, Enum.Font.Roboto, Enum.Font.RobotoCondensed,
    Enum.Font.Antique, Enum.Font.Arcade, Enum.Font.Fantasy, Enum.Font.SciFi,
    Enum.Font.Fondamento, Enum.Font.Bangers, Enum.Font.Creepster,
    Enum.Font.DenkOne, Enum.Font.GrenzeGotisch, Enum.Font.IndieFlower,
    Enum.Font.JosefinSans, Enum.Font.Jura, Enum.Font.Kalam,
    Enum.Font.LuckiestGuy, Enum.Font.Merriweather, Enum.Font.Michroma,
    Enum.Font.Nunito, Enum.Font.Oswald, Enum.Font.PatrickHand,
    Enum.Font.PermanentMarker, Enum.Font.RobotoMono, Enum.Font.Sarpanch,
    Enum.Font.SpecialElite, Enum.Font.TitilliumWeb, Enum.Font.Ubuntu,
}
local fontIndex = 1

-- ============================================================
-- BAGIAN 1: OPTIMIZER
-- ============================================================
local function runOptimizer()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 300
    Lighting.ShadowSoftness = 0
    Lighting.Brightness = 1
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 1
    end

    local function optimizePart(part)
        if not part:IsA("BasePart") then return end
        if part.Transparency >= 1 and not part:IsA("MeshPart") then
            part:Destroy()
            return
        end
        if part.CanCollide == false and part.Size.Magnitude < MIN_PART_SIZE then
            part:Destroy()
            return
        end
        part.CastShadow = false
        if part.Material ~= Enum.Material.SmoothPlastic then
            part.Material = Enum.Material.SmoothPlastic
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        optimizePart(obj)
    end

    pcall(function()
        Workspace.StreamingEnabled = true
    end)

    local camera = Workspace.CurrentCamera
    local function cullFarParts()
        if not camera then return end
        local camPos = camera.CFrame.Position
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local dist = (obj.Position - camPos).Magnitude
                if dist > MAX_DISTANCE then
                    obj.LocalTransparencyModifier = 1
                else
                    obj.LocalTransparencyModifier = 0
                end
            end
        end
    end

    task.spawn(function()
        while task.wait(CULL_INTERVAL) do
            cullFarParts()
        end
    end)

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)

    SoundService.RespectFilteringEnabled = true
end

-- ============================================================
-- BAGIAN 2: UI
-- ============================================================
local function buildUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "PremiumUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Parent = player:WaitForChild("PlayerGui")

    local main = Instance.new("Frame")
    main.Name = "MainFrame"
    main.Size = UDim2.new(0, 280, 0, 260)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.new(0.5, 0, 0.7, 0)
    main.BackgroundColor3 = BG_TOP
    main.BorderSizePixel = 0
    main.Parent = gui

    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke", main)
    stroke.Thickness = 1.5
    stroke.Transparency = 0.6
    stroke.Color = ACCENT

    local grad = Instance.new("UIGradient", main)
    grad.Rotation = 90
    grad.Color = ColorSequence.new(BG_TOP, BG_BOT)

    local pad = Instance.new("UIPadding", main)
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)

    local title = Instance.new("Frame")
    title.Name = "TitleBar"
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    title.BorderSizePixel = 0
    title.Parent = main

    Instance.new("UICorner", title).CornerRadius = UDim.new(0, 8)

    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -40, 1, 0)
    tLabel.Position = UDim2.new(0, 12, 0, 0)
    tLabel.BackgroundTransparency = 1
    tLabel.Text = "PREMIUM PANEL"
    tLabel.TextColor3 = TEXT_C
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 14
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = title

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 28, 0, 28)
    close.Position = UDim2.new(1, -34, 0, 6)
    close.BackgroundColor3 = Color3.fromRGB(200, 60, 80)
    close.Text = "X"
    close.TextColor3 = TEXT_C
    close.Font = Enum.Font.GothamBold
    close.TextSize = 14
    close.AutoButtonColor = false
    close.Parent = title

    Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)

    close.MouseButton1Click:Connect(function()
        main.Visible = false
    end)

    local list = Instance.new("Frame")
    list.Name = "MenuList"
    list.Size = UDim2.new(1, 0, 1, -48)
    list.Position = UDim2.new(0, 0, 0, 48)
    list.BackgroundTransparency = 1
    list.Parent = main

    local layout = Instance.new("UIListLayout", list)
    layout.Padding = UDim.new(0, 6)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local trackedTexts = {tLabel}

    local function applyFont(fontEnum)
        for _, obj in ipairs(trackedTexts) do
            if obj and obj.Parent then
                obj.Font = fontEnum
            end
        end
    end

    local function makeButton(text, order)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 36)
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 55)
        btn.Text = "  " .. text
        btn.TextColor3 = TEXT_C
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 13
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.LayoutOrder = order
        btn.Parent = list

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

        local s = Instance.new("UIStroke", btn)
        s.Thickness = 1
        s.Transparency = 0.8
        s.Color = ACCENT

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(50, 45, 80)
            }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(35, 35, 55)
            }):Play()
        end)

        table.insert(trackedTexts, btn)
        return btn
    end

    makeButton("Item Arsenal", 1)
    makeButton("Novel Archive", 2)
    makeButton("Settings", 3)

    local fontBtn = makeButton("Font: Gotham", 4)

    fontBtn.MouseButton1Click:Connect(function()
        fontIndex = fontIndex + 1
        if fontIndex > #FONTS then fontIndex = 1 end
        local f = FONTS[fontIndex]
        applyFont(f)
        fontBtn.Text = "  Font: " .. f.Name
    end)

    TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0.5, 0)
    }):Play()
end

-- ============================================================
-- JALANKAN
-- ============================================================
runOptimizer()
buildUI()

print("[PremiumUI_Optimizer] aktif. Valid.")
