-- Event saat senjata di-equip (Aman)
local function onToolAdded(tool)
    if not tool:IsA("Tool") then return end
    local sm = tool:FindFirstChild("Setting")
    if not (sm and sm:IsA("ModuleScript")) then return end
    
    task.wait(0.2)
    local ok, s = pcall(require, sm)
    if ok and type(s) == "table" then
        if recoilOn then
            if s.Recoil then s.Recoil = 0 end
            if s.SpreadX then s.SpreadX = 0 end
            if s.SpreadY then s.SpreadY = 0 end
            if s.CameraRecoil then s.CameraRecoil = 0 end
        end
        if soundOn then
            if s.HitCharSndIDs then s.HitCharSndIDs = {9125402735} end
            if s.HitSndIDs then s.HitSndIDs = {9125402735} end
        end
        if macroOn then
            if s.Auto then s.Auto = true end
            if s.FireRate then s.FireRate = 0.05 end
        end
    end
end

if LP.Character then LP.Character.ChildAdded:Connect(onToolAdded) end
LP.CharacterAdded:Connect(function(char) char.ChildAdded:Connect(onToolAdded) end)

makeToggle("Macro Tembak (Auto)", false, function(s) 
    macroOn = s 
    if LP.Character then
        for _, v in pairs(LP.Character:GetChildren()) do onToolAdded(v) end
    end
end)

