-- FITUR OPTIMIZE
local state = {
    LowGraphics = false,
    FPSBoost = false,
    ClearParticles = false,
    HideSky = false,
    DisableShadows = false,
}

local disabledParticles = {}

local function applyLowGraphics(on)
    Lighting.GlobalShadows = not on
    Lighting.FogEnd = on and 100000 or 1000
    Lighting.EnvironmentDiffuseScale = on and 0 or 1
    Lighting.EnvironmentSpecularScale = on and 0 or 1
end

local function applyFPSBoost(on)
    pcall(function()
        settings().Rendering.QualityLevel = on and 1 or 10
    end)
    Workspace.Terrain.WaterWaveSize = on and 0 or 1
    Workspace.Terrain.WaterWaveSpeed = on and 0 or 1
end

local function applyClearParticles(on)
    if on then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("Smoke") or obj:IsA("Fire") then
                if obj.Enabled then
                    obj.Enabled = false
                    table.insert(disabledParticles, obj)
                end
            end
        end
    else
        for _, obj in ipairs(disabledParticles) do
            if obj.Parent then obj.Enabled = true end
        end
        disabledParticles = {}
    end
end

local function applyHideSky(on)
    local sky = Lighting:FindFirstChildOfClass("Sky")
    if on and sky then sky.Parent = nil end
end

local function applyDisableShadows(on)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CastShadow = not on
        end
    end
end

local map = {
    LowGraphics = applyLowGraphics,
    FPSBoost = applyFPSBoost,
    ClearParticles = applyClearParticles,
    HideSky = applyHideSky,
    DisableShadows = applyDisableShadows,
}

-- ===== TOMBOL FITUR (INI YANG KAU MINTA) =====
local buttons = {}
local urutan = {"LowGraphics", "FPSBoost", "ClearParticles", "HideSky", "DisableShadows"}

for _, name in ipairs(urutan) do
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    btn.Text = name .. ": Off"
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.AutoButtonColor = true
    btn.Parent = scroll
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(70, 70, 80)

    btn.MouseButton1Click:Connect(function()
        if not premium then return end -- blokir non-premium
        state[name] = not state[name]
        map[name](state[name])
        btn.Text = name .. ": " .. (state[name] and "On" or "Off")
        btn.BackgroundColor3 = state[name]
            and Color3.fromRGB(40, 120, 60)
            or Color3.fromRGB(45, 45, 55)
        btnStroke.Color = state[name]
            and Color3.fromRGB(0, 200, 100)
            or Color3.fromRGB(70, 70, 80)
    end)
    buttons[name] = btn
end

