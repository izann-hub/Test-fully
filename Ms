-- ================= FITUR GEPENG =================
local stretchOn = false
local stretchScale = 0.65

local function updateStretch()
    pcall(function() RunService:UnbindFromRenderStep("JenowaStretch") end)
    if stretchOn then
        RunService:BindToRenderStep("JenowaStretch", Enum.RenderPriority.Camera.Value + 1, function()
            local cam = workspace.CurrentCamera
            cam.CFrame = cam.CFrame * CFrame.new(0, 0, 0, 1, 0, 0, 0, stretchScale, 0, 0, 0, 1)
        end)
    end
end

makeToggle("Gepeng Layar", false, function(s)
    stretchOn = s
    updateStretch()
end)

makeSlider("Skala Gepeng", 0.1, 1, 0.65, function(v)
    stretchScale = v
    if stretchOn then updateStretch() end
end)

