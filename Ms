-- ============================================
-- 🧰 EQUIP
-- ============================================
local function EquipItemExact(namaItem)
    local char = player.Character
    if not char then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    hum:UnequipTools()
    task.wait(0.2)

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:lower() == namaItem:lower() then
            return true
        end
    end

    local targetTool = nil
    local backpack = player:FindFirstChild("Backpack")

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.Name:lower() == namaItem:lower() then
                targetTool = tool
                break
            end
        end

        if not targetTool then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and tool.Name:lower():find(namaItem:lower(), 1, true) then
                    targetTool = tool
                    print("⚠️ Partial match:", tool.Name, "→", namaItem)
                    break
                end
            end
        end
    end

    if not targetTool then
        warn("❌ Tool tidak ditemukan:", namaItem)
        return false
    end

    hum:EquipTool(targetTool)

    local timeout = 0
    while timeout < 1.5 do
        task.wait(0.05)
        timeout = timeout + 0.05
        local equipped = char:FindFirstChild(targetTool.Name)
        if equipped and equipped:IsA("Tool") then
            print("✅ Equipped:", targetTool.Name)
            return true
        end
    end

    warn("❌ Equip timeout:", namaItem)
    return false
end

local function EquipItemWithRetry(namaItem, maxRetry)
    maxRetry = maxRetry or 3
    for i = 1, maxRetry do
        if EquipItemExact(namaItem) then
            return true
        end
        warn("🔁 Retry " .. i .. "/" .. maxRetry .. " untuk " .. namaItem)
        task.wait(0.4)
    end
    return false
end

