-- GepengServer Lengkap (AUTO-BUILD ARENA) | Dark Angel
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- ===== 1. BUAT REMOTES DI AWAL =====
local remotes = ReplicatedStorage:FindFirstChild("GepengRemotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "GepengRemotes"
	remotes.Parent = ReplicatedStorage
end

local function ambilAtauBuat(parent, nama, kelas)
	local obj = parent:FindFirstChild(nama)
	if not obj then
		obj = Instance.new(kelas)
		obj.Name = nama
		obj.Parent = parent
	end
	return obj
end

local updateUI = ambilAtauBuat(remotes, "UpdateUI", "RemoteEvent")
local ValidasiAksi = ambilAtauBuat(remotes, "ValidasiAksi", "RemoteEvent")
local Heartbeat = ambilAtauBuat(remotes, "Heartbeat", "RemoteEvent")
local UbahUkuran = ambilAtauBuat(remotes, "UbahUkuran", "RemoteEvent")

-- ===== 2. STATE GAME =====
local BUNTU = {5, 9, 14, 18}
local posPelari, posPengejar = 1, 20
local ketuk, diamPelari = 0, 0
local selesai = false
local ukuranGepeng = 4 -- Default lebar lorong

local Arena, Aktor, Rintangan, Pelari, Pengejar

-- ===== 3. ANTI-CHEAT =====
local logKick, curang, gagalValidasi = {}, {}, {}
local TOLERANSI = 3
local cooldownRemote, COOLDOWN = {}, 0.1

local function bolehKirim(pemain)
	local now = os.clock()
	if cooldownRemote[pemain.UserId] and now - cooldownRemote[pemain.UserId] < COOLDOWN then return false end
	cooldownRemote[pemain.UserId] = now
	return true
end

local function kirimPeringatan(pemain, jenis, pesan)
	updateUI:FireClient(pemain, { peringatan = { jenis = jenis, pesan = pesan } })
end

-- ===== 4. FUNGSI BUAT ARENA OTOMATIS =====
local function hancurkanArena()
	for _, nama in ipairs({"Gepeng_Arena", "Gepeng_Aktor", "Gepeng_Rintangan"}) do
		local lama = Workspace:FindFirstChild(nama)
		if lama then lama:Destroy() end
	end
end

local function buatArena()
	hancurkanArena()

	Arena = Instance.new("Folder"); Arena.Name = "Gepeng_Arena"; Arena.Parent = Workspace
	Aktor = Instance.new("Folder"); Aktor.Name = "Gepeng_Aktor"; Aktor.Parent = Workspace
	Rintangan = Instance.new("Folder"); Rintangan.Name = "Gepeng_Rintangan"; Rintangan.Parent = Workspace

	-- Buat lorong (20 part)
	for i = 1, 20 do
		local p = Instance.new("Part")
		p.Name = "Lorong_" .. i
		p.Size = Vector3.new(ukuranGepeng * 2, 1, 4)
		p.Position = Vector3.new(0, 0, -i * 4)
		p.Anchored = true
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(40, 40, 50)
		p.Parent = Arena
	end

	-- Buat buntu
	for i = 1, #BUNTU do
		local nomor = BUNTU[i]
		local p = Instance.new("Part")
		p.Name = "Buntu_" .. nomor
		p.Size = Vector3.new(ukuranGepeng * 2, 1, 4)
		p.Position = Vector3.new(ukuranGepeng * 2 + 4, 0, -nomor * 4)
		p.Anchored = true
		p.Color = Color3.fromRGB(30, 30, 40)
		p.Parent = Arena
	end

	-- Buat rintangan
	local posRintangan = {7, 12, 16}
	for i = 1, 3 do
		local p = Instance.new("Part")
		p.Name = "Rintangan_" .. i .. "_" .. posRintangan[i]
		p.Size = Vector3.new(ukuranGepeng * 2, 0.2, 4)
		p.Position = Vector3.new(0, 0.6, -posRintangan[i] * 4)
		p.Anchored = true
		p.CanCollide = false
		if i == 1 then p.Color = Color3.fromRGB(0, 100, 255)
		elseif i == 2 then p.Color = Color3.fromRGB(255, 0, 0)
		else p.Color = Color3.fromRGB(0, 0, 0) end
		p.Transparency = 0.5
		p.Parent = Rintangan
	end

	-- Buat Aktor
	Pelari = Instance.new("Part")
	Pelari.Name = "Pelari"; Pelari.Size = Vector3.new(2, 2, 2)
	Pelari.Color = Color3.fromRGB(0, 150, 255); Pelari.Anchored = true; Pelari.CanCollide = false
	Pelari.Parent = Aktor

	Pengejar = Instance.new("Part")
	Pengejar.Name = "Pengejar"; Pengejar.Size = Vector3.new(2, 2, 2)
	Pengejar.Color = Color3.fromRGB(255, 50, 50); Pengejar.Anchored = true; Pengejar.CanCollide = false
	Pengejar.Parent = Aktor

	resetRonde()
end

function resetRonde()
	posPelari, posPengejar = 1, 20
	ketuk, diamPelari, selesai = 0, 0, false
	if Pelari and Pengejar then
		tempatkan(Pelari, posPelari)
		tempatkan(Pengejar, posPengejar)
	end
	kirimUI()
end

function tempatkan(aktor, nomor)
	local p = Arena:FindFirstChild("Lorong_" .. nomor)
	if p then aktor.Position = p.Position + Vector3.new(0, 3, 0) end
end

function kirimUI()
	updateUI:FireAllClients({
		ketuk = ketuk, pelari = posPelari, pengejar = posPengejar,
		buntu = BUNTU, selesai = selesai,
		panjang = 20, lebar = ukuranGepeng, rintangan = 3
	})
end

-- ===== 5. LOGIKA GAME =====
local function cekRintangan(nomor)
	for _, r in ipairs(Rintangan:GetChildren()) do
		local n = tonumber(r.Name:match("_(%d+)$"))
		if n == nomor then
			if r.Name:find("Rintangan_1") then diamPelari += 1
			elseif r.Name:find("Rintangan_2") then
				if math.random(1, 6) % 2 == 0 then posPengejar += 1 end
			elseif r.Name:find("Rintangan_3") then diamPelari += 1 end
		end
	end
end

local function langkah()
	if selesai or not Pelari then return end
	ketuk += 1
	if diamPelari > 0 then diamPelari -= 1 else posPelari += 1 end
	if ketuk % 2 == 0 then posPengejar += 1 end
	if posPelari > 20 then posPelari = 20 end
	if posPengejar > 20 then posPengejar = 20 end
	tempatkan(Pelari, posPelari)
	tempatkan(Pengejar, posPengejar)
	cekRintangan(posPelari)
	kirimUI()
	if posPengejar >= posPelari then selesai = true; kirimUI() end
end

-- ===== 6. REMOTE UBAH UKURAN =====
UbahUkuran.OnServerEvent:Connect(function(pemain, lebar)
	if not bolehKirim(pemain) then return end
	if type(lebar) == "number" then
		ukuranGepeng = math.clamp(lebar, 2, 10)
		buatArena() -- Bangun ulang arena dengan lebar baru
	end
end)

-- ===== 7. VALIDASI =====
ValidasiAksi.OnServerEvent:Connect(function(pemain, aksi, dari, ke)
	if not bolehKirim(pemain) or type(aksi) ~= "string" then return end
	if aksi == "kick_report" then
		table.insert(logKick, 1, { pemain = pemain.Name, waktu = os.time() })
		if #logKick > 5 then table.remove(logKick) end
		return
	end
	if aksi == "gerak" then
		local valid = (type(dari) == "number" and type(ke) == "number" and math.abs(ke - dari) == 1 and ke >= 1 and ke <= 20)
		if not valid then
			gagalValidasi[pemain.UserId] = (gagalValidasi[pemain.UserId] or 0) + 1
			if gagalValidasi[pemain.UserId] >= TOLERANSI then
				curang[pemain.UserId] = true
				kirimPeringatan(pemain, "curang", "Validasi gagal 3 kali. Ronde dihentikan.")
			else
				kirimPeringatan(pemain, "curang", "Aksi tidak valid (" .. gagalValidasi[pemain.UserId] .. "/3).")
			end
		else gagalValidasi[pemain.UserId] = 0 end
	end
end)

Heartbeat.OnServerEvent:Connect(function(pemain, waktu) if type(waktu) == "number" then Heartbeat:FireClient(pemain, os.clock()) end end)
Players.PlayerRemoving:Connect(function(p) gagalValidasi[p.UserId] = nil; curang[p.UserId] = nil; cooldownRemote[p.UserId] = nil end)

-- ===== 8. MULAI =====
buatArena() -- Langsung buat arena saat server jalan

task.spawn(function()
	while true do
		task.wait(2)
		if not selesai then langkah() end
	end
end)
