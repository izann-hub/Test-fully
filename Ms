-- Drag Logic
local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
safeUIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
safeUIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

-- Open/Close Logic
local isOpen = false
local function toggleUI()
    isOpen = not isOpen
    if isOpen then
        floatBtn.Visible = false
        MainFrame.Visible = true
        
        TS:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 460, 0, 340),
            BackgroundTransparency = 0
        }):Play()
        TS:Create(blur, TweenInfo.new(0.4), {Size = 10}):Play()
    else
        TS:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 1
        }):Play()
        TS:Create(blur, TweenInfo.new(0.3), {Size = 0}):Play()
        
        task.delay(0.3, function()
            MainFrame.Visible = false
            floatBtn.Visible = true
        end)
    end
end

floatBtn.MouseButton1Click:Connect(toggleUI)
Close.MouseButton1Click:Connect(toggleUI)

