local function makeToggle(text, state, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 46)
    f.BackgroundColor3 = Palette.ElementBg
    f.Parent = Body
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 8); fc.Parent = f
    local fs = Instance.new("UIStroke"); fs.Color = Color3.fromRGB(40, 40, 45); fs.Thickness = 1; fs.Parent = f

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -70, 1, 0)
    l.Position = UDim2.new(0, 15, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Palette.White
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 14
    l.Parent = f

    local track = Instance.new("TextButton")
    track.Size = UDim2.new(0, 46, 0, 24)
    track.Position = UDim2.new(1, -61, 0.5, -12)
    track.BackgroundColor3 = state and Palette.Red or Color3.fromRGB(15, 15, 18)
    track.Text = ""
    track.AutoButtonColor = false
    track.ClipsDescendants = true
    track.Parent = f
    local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(1, 0); tc.Parent = track
    local ts = Instance.new("UIStroke"); ts.Color = state and Palette.Red or Color3.fromRGB(40,40,45); ts.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.Position = state and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
    knob.BackgroundColor3 = Palette.White
    knob.Parent = track
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob

    local on = state
    track.MouseButton1Click:Connect(function()
        on = not on
        local ti = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TS:Create(track, ti, {BackgroundColor3 = on and Palette.Red or Color3.fromRGB(15, 15, 18)}):Play()
        TS:Create(ts, ti, {Color = on and Palette.Red or Color3.fromRGB(40,40,45)}):Play()
        TS:Create(knob, ti, {Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)}):Play()
        if cb then cb(on) end
    end)
    return f
end

local function makeSlider(text, min, max, default, cb)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 50)
    f.BackgroundColor3 = Palette.ElementBg
    f.Parent = Body
    local fc = Instance.new("UICorner"); fc.CornerRadius = UDim.new(0, 8); fc.Parent = f
    local fs = Instance.new("UIStroke"); fs.Color = Color3.fromRGB(40, 40, 45); fs.Thickness = 1; fs.Parent = f

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -20, 0, 16)
    l.Position = UDim2.new(0, 15, 0, 8)
    l.BackgroundTransparency = 1
    l.Text = text .. ": " .. default
    l.TextColor3 = Palette.White
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Font = Enum.Font.GothamMedium
    l.TextSize = 13
    l.Parent = f

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -30, 0, 4)
    track.Position = UDim2.new(0, 15, 0, 34)
    track.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    track.Parent = f
    local trc = Instance.new("UICorner"); trc.CornerRadius = UDim.new(1, 0); trc.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Palette.Red
    fill.Parent = track
    local fc2 = Instance.new("UICorner"); fc2.CornerRadius = UDim.new(1, 0); fc2.Parent = fill
    
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(fill.Size.X.Scale, 0, 0.5, -7)
    knob.BackgroundColor3 = Palette.White
    knob.ZIndex = 3
    knob.Parent = track
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.new(1, 0); kc.Parent = knob
    local ks = Instance.new("UIStroke"); ks.Color = Palette.Red; ks.Thickness = 2; ks.Parent = knob

    local val = default
    local dragging2 = false
    
    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
            dragging2 = true 
        end
    end)
    
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then 
            dragging2 = false 
        end
    end)
    
    UIS.InputChanged:Connect(function(i)
        if dragging2 and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local rel = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            val = math.floor((min + (max - min) * rel) * 100 + 0.5) / 100
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, 0, 0.5, -7)
            l.Text = text .. ": " .. val
            if cb then cb(val) end
        end
    end)
    return f
end

