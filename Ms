-- Force Loop dengan Jeda Acak (Anti-Deteksi Pattern)
task.spawn(function()
    while task.wait(math.random(0.15, 0.3)) do
        if not macroOn and not recoilOn then continue end
        
        local tools = {}
        if LP.Character then
            for _, v in pairs(LP.Character:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v) end end
        end
        if LP:FindFirstChild("Backpack") then
            for _, v in pairs(LP.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v) end end
        end

        for _, tool in pairs(tools) do
            local sm = tool:FindFirstChild("Setting")
            if sm and sm:IsA("ModuleScript") then
                local ok, s = pcall(require, sm)
                if ok and type(s) == "table" then
                    -- Paksa No Recoil
                    if recoilOn then
                        s.Recoil = 0
                        s.SpreadX = 0
                        s.SpreadY = 0
                        s.Accuracy = 1
                        s.CameraRecoil = 0
                    end
                    -- Paksa Macro (Auto Fire)
                    if macroOn then
                        s.Auto = true
                        s.FireRate = 0.04
                    end
                end
            end
        end
    end
end)

