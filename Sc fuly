local APRT_NAMES = {
    "CompactWalkupAPT1", "CompactWalkupAPT2", "CompactWalkupAPT3",
    "CompactWalkupAPT4", "CompactWalkupAPT5", "CompactWalkupAPT6",
}

local function GetAprtBoardText(board)
    local txt = ""
    local namePart = board:FindFirstChild("name")
    if namePart then
        local sg = namePart:FindFirstChild("SurfaceGui")
        local tl = sg and sg:FindFirstChildWhichIsA("TextLabel", true)
        if tl then txt = tl.Text end
    end
    if txt == "" then
        local sg = board:FindFirstChild("SurfaceGui")
        if sg then
            local occ = sg:FindFirstChild("Occupation")
            if occ then txt = occ.Text
            else
                local tl = sg:FindFirstChildWhichIsA("TextLabel", true)
                if tl then txt = tl.Text end
            end
        end
    end
    return txt
end

local function FindAprt()
    local map = Workspace:FindFirstChild("Map")
    local aptFolder = map and map:FindFirstChild("Apartments")
    if not aptFolder then return nil, nil end
    
    for _, name in ipairs(APRT_NAMES) do
        local obj = aptFolder:FindFirstChild(name)
        if not obj then continue end
        local board = obj:FindFirstChild("Board", true)
        if not board then continue end
        local txt = GetAprtBoardText(board)
        if txt == LP.Name then
            return obj, "Owned"
        end
    end
    return nil, nil
end

local function EnsureBuyAprt()
    local obj, status = FindAprt()
    if status == "Owned" then return true end
    
    local map = Workspace:FindFirstChild("Map")
    local aptFolder = map and map:FindFirstChild("Apartments")
    if not aptFolder then return false end
    
    for _, name in ipairs(APRT_NAMES) do
        local obj = aptFolder:FindFirstChild(name)
        if not obj then continue end
        
        local board = obj:FindFirstChild("Board", true)
        if not board then continue end
        
        local txt = GetAprtBoardText(board)
        if txt == "VACANT" then
            local backboard = board:FindFirstChild("backboard")
            local bp = backboard and backboard:FindFirstChildWhichIsA("ProximityPrompt", true)
            if not bp then bp = board:FindFirstChildWhichIsA("ProximityPrompt", true) end
            if not bp then continue end
            
            bp.MaxActivationDistance = 9999
            bp.RequiresLineOfSight = false
            bp.HoldDuration = 0
            
            local boardPos = board.Position or Vector3.new(0, 0, 0)
            
            local awayDir = board.CFrame.LookVector
            if awayDir.Magnitude < 0.5 then
                awayDir = Vector3.new(0, 0, 1)
            end
            awayDir = awayDir.Unit
            
            local rayOrigin = boardPos + Vector3.new(0, 5, 0)
            local rayDir = Vector3.new(0, -20, 0)
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = { LP.Character }
            
            local rayResult = Workspace:Raycast(rayOrigin, rayDir, rayParams)
            local floorY = boardPos.Y
            if rayResult then
                floorY = rayResult.Position.Y
            end
            
            local safePos = Vector3.new(
                boardPos.X + (awayDir.X * APART_OFFSET),
                floorY + 0.5,
                boardPos.Z + (awayDir.Z * APART_OFFSET)
            )
            
            print("🏢 Teleport ke apartment (offset 0.2m, floor Y=" .. floorY .. ")...")
            SafeTeleport(safePos, "Apartment")
            task.wait(0.5)
            
            local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position.Y < floorY - 2) then
                print("⚠️ Jatuh ke tangga, paksa naik...")
                root.CFrame = CFrame.new(safePos)
                task.wait(0.5)
            end
            
            task.wait(1)
            
            FirePrompt(bp)
            task.wait(3)
            
            local checkTxt = GetAprtBoardText(board)
            if checkTxt ~= LP.Name then
                print("⚠️ First try failed, retry...")
                FirePrompt(bp)
                task.wait(3)
            end
            
            return true
        end
    end
    
    return false
end

