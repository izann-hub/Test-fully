local function createTab(name, accentColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 36)
    btn.BackgroundColor3 = Palette.Dark
    btn.Text = name
    btn.TextColor3 = Palette.Light
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamMedium
    btn.BorderSizePixel = 0
    btn.ZIndex = 3
    btn.Parent = Sidebar

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 8)
    bc.Parent = btn

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 0)
    indicator.Position = UDim2.new(0, 0, 0.5, 0)
    indicator.AnchorPoint = Vector2.new(0, 0.5)
    indicator.BackgroundColor3 = accentColor
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 4
    indicator.Parent = btn

    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = indicator

    local frame = Instance.new("ScrollingFrame")
    frame.Size = UDim2.new(1, -20, 1, -20)
    frame.Position = UDim2.new(0, 10, 0, 10)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 6
    frame.ScrollBarImageColor3 = accentColor
    frame.ScrollBarImageTransparency = 0.3
    frame.ScrollingDirection = Enum.ScrollingDirection.Y
    frame.CanvasSize = UDim2.new(0, 0, 0, 0)
    frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    frame.ClipsDescendants = true
    frame.ZIndex = 2
    frame.Visible = false
    frame.Parent = Content

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = frame

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 4)
    pad.PaddingBottom = UDim.new(0, 24)
    pad.Parent = frame

    tabs[name] = {
        button = btn, frame = frame, accent = accentColor,
        layout = layout, indicator = indicator
    }

    btn.MouseEnter:Connect(function()
        if activeTab ~= name then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Palette.DarkGray}):Play()
        end
        TweenService:Create(indicator, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 3, 0, 20)}):Play()
    end)

    btn.MouseLeave:Connect(function()
        if activeTab ~= name then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Palette.Dark}):Play()
        end
        TweenService:Create(indicator, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 3, 0, 0)}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        if isSwitching or activeTab == name then return end
        isSwitching = true
        for n, t in pairs(tabs) do
            if n ~= name then
                t.frame.Visible = false
                TweenService:Create(t.button, TweenInfo.new(0.2), {BackgroundColor3 = Palette.Dark}):Play()
                TweenService:Create(t.indicator, TweenInfo.new(0.2), {Size = UDim2.new(0, 3, 0, 0)}):Play()
            end
        end
        local accent = tabs[name].accent
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = accent}):Play()
        TweenService:Create(indicator, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 3, 0, 28)}):Play()
        frame.Position = UDim2.new(0, 40, 0, 10)
        frame.Visible = true
        TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 10, 0, 10)
        }):Play()
        activeTab = name
        task.wait(0.25)
        isSwitching = false
    end)

    return frame
end

