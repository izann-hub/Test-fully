local noclipConn = nil
local noclipRunning = false
local lastNoclipTick = 0

local function EnableNoClipPermanent()
    if noclipRunning then return end
    noclipRunning = true
    noclipConn = RunService.Stepped:Connect(function()
        if not noclipRunning then return end
        local now = tick()
        if now - lastNoclipTick < 0.1 then return end
        lastNoclipTick = now
        local char = Player.Character
        if not char or not char.Parent then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        local names = {
            "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso",
            "Left Arm", "Right Arm", "Left Leg", "Right Leg",
            "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
            "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
            "LeftFoot", "RightFoot",
        }
        for _, n in ipairs(names) do
            local p = char:FindFirstChild(n)
            if p and p:IsA("BasePart") and p.CanCollide then
                p.CanCollide = false
            end
        end
    end)
end

local function DisableNoClipPermanent()
    noclipRunning = false
    if noclipConn then
        pcall(function() noclipConn:Disconnect() end)
        noclipConn = nil
    end
    local char = Player.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = true end)
            end
        end
    end
end

Player.CharacterAdded:Connect(function()
    task.wait(2)
    if noclipRunning then EnableNoClipPermanent() end
end)

