    pcall(function() Lighting.GlobalShadows = false end)
    pcall(function() Lighting.FogEnd = 9e9 end)
    pcall(function() Lighting.Brightness = 2 end)

    pcall(function()
        for _, effect in pairs(Lighting:GetChildren()) do
            if effect:IsA("BlurEffect") or effect:IsA("BloomEffect")
            or effect:IsA("SunRaysEffect") or effect:IsA("DepthOfFieldEffect")
            or effect:IsA("ColorCorrectionEffect") then
                BoostFPS.OriginalSettings[effect.Name] = effect.Enabled
                effect.Enabled = false
            end
        end
    end)

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
end

local function DisableBoostFPS()
    if not BoostFPS.Enabled then return end
    BoostFPS.Enabled = false
    print("Boost FPS: OFF")

    pcall(function() Lighting.GlobalShadows = BoostFPS.OriginalSettings.GlobalShadows end)
    pcall(function() Lighting.FogEnd = BoostFPS.OriginalSettings.FogEnd end)
    pcall(function() Lighting.Brightness = BoostFPS.OriginalSettings.Brightness end)

    pcall(function()
        for _, effect in pairs(Lighting:GetChildren()) do
            if BoostFPS.OriginalSettings[effect.Name] ~= nil then
                effect.Enabled = BoostFPS.OriginalSettings[effect.Name]
            end
        end
    end)

    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
    end)
end

