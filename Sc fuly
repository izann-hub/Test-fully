-- FIND SEAT / OWN BIKE
-- ============================================================
local function FindDriveSeat(bike)
    if not bike then return nil end
    for _, name in ipairs(DRIVER_SEAT_NAMES) do
        local s = bike:FindFirstChild(name, true)
        if s and (s:IsA("VehicleSeat") or s:IsA("Seat")) then return s end
    end
    local seats = {}
    for _, d in ipairs(bike:GetDescendants()) do
        if d:IsA("VehicleSeat") or d:IsA("Seat") then table.insert(seats, d) end
    end
    if #seats == 0 then return nil end
    if #seats == 1 then return seats[1] end
    local filtered = {}
    for _, s in ipairs(seats) do
        local n = s.Name:lower()
        if not (n:find("passenger") or n:find("back") or n:find("rear") or n:find("penumpang") or n:find("belakang")) then
            table.insert(filtered, s)
        end
    end
    if #filtered == 1 then return filtered[1] end
    if #filtered > 1 then
        table.sort(filtered, function(a, b) return a.Position.Z < b.Position.Z end)
        return filtered[1]
    end
    return nil
end

local function IsDriverSeat(seat)
    if not seat then return false end
    local n = seat.Name:lower()
    return not (n:find("passenger") or n:find("back") or n:find("rear") or n:find("penumpang") or n:find("belakang"))
end

local function IsMyBike(model)
    if not model or not model:IsA("Model") then return false end
    local myName, myUserId = LP.Name, tostring(LP.UserId)
    for _, attr in ipairs({"Owner","OwnerId","UserId","Player","Creator","VehicleOwner","owner","ownerId","userId","player","creator","vehicleOwner"}) do
        local ok, val = pcall(function() return model:GetAttribute(attr) end)
        if ok and val ~= nil then
            if val == LP or val == myUserId or val == myName or tostring(val) == myUserId or tostring(val) == myName then
                return true
            end
        end
    end
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ObjectValue") then
            local n = child.Name:lower()
            if n:find("owner") or n:find("creator") or n:find("player") or n:find("user") then
                if child.Value == LP then return true end
            end
        elseif child:IsA("StringValue") then
            local n = child.Name:lower()
            if n:find("owner") or n:find("user") or n:find("player") then
                if child.Value == myName or child.Value == myUserId then return true end
            end
        end
    end
    local parent, depth = model.Parent, 0
    while parent and parent ~= Workspace and depth < 5 do
        local pn = parent.Name
        if pn == myName or pn == myUserId or pn:find(myName, 1, true) or pn:find(myUserId, 1, true) then return true end
        parent = parent.Parent
        depth  = depth + 1
    end
    local mn = model.Name
    if mn:find(myName, 1, true) or mn:find(myUserId, 1, true) then return true end
    return false
end

local function IsOthersBike(model)
    for _, child in ipairs(model:GetDescendants()) do
        if child:IsA("ObjectValue") then
            local n = child.Name:lower()
            if n:find("owner") or n:find("player") or n:find("creator") then
                if child.Value and child.Value:IsA("Player") and child.Value ~= LP then return true end
            end
        end
    end
    return false
end

local function FindMyBikeAuto()
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local myPos = hrp and hrp.Position or Vector3.zero
    local candidates = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local seat = FindDriveSeat(obj)
            if seat and IsDriverSeat(seat) and not IsOthersBike(obj) then
                local isMine = IsMyBike(obj)
                if not REQUIRE_OWN_BIKE or isMine then
                    table.insert(candidates, { model = obj, seat = seat, ownerPrio = isMine and 0 or 1 })
                end
            end
        end
    end
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b)
        if a.ownerPrio ~= b.ownerPrio then return a.ownerPrio < b.ownerPrio end
        local da = (a.model:GetPivot().Position - myPos).Magnitude
        local db = (b.model:GetPivot().Position - myPos).Magnitude
        return da < db
    end)
    return candidates[1].model
end

-- ============================================================
-- PROMPT INTERACT
-- ============================================================
local function InteractPromptNormal(prompt, holdSec)
    if not prompt then return false end
    holdSec = holdSec or HOLD_DURATION
    if not prompt.Enabled then return false end

    local origHold = prompt.HoldDuration
    local origLos  = prompt.RequiresLineOfSight
    local origDist = prompt.MaxActivationDistance

    pcall(function()
        prompt.HoldDuration          = 0
        prompt.RequiresLineOfSight   = false
        prompt.MaxActivationDistance = 9e9
    end)

    local ok = pcall(function()
        fireproximityprompt(prompt)
    end)

    if not ok then
        pcall(function() prompt:InputHoldBegin() end)
        task.wait(holdSec)
        pcall(function() prompt:InputHoldEnd() end)
    end

    task.wait(0.2)

    pcall(function()
        prompt.HoldDuration          = origHold
        prompt.RequiresLineOfSight   = origLos
        prompt.MaxActivationDistance = origDist
    end)

    return true
end

-- ============================================================
-- AUTO SIT MOTOR
-- ============================================================
local function AutoSitMotor()
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return false end

    if hum.SeatPart then
        _MotorState.seat = hum.SeatPart
        _MotorState.bike = hum.SeatPart.Parent
        FarmState.BikeSitting = true
        return true
    end

    local bike = FindMyBikeAuto()

    if not bike then
        if Reliable and RELIABLE_ARG_SPAWN_MOTOR then
            pcall(function() Reliable:FireServer(RELIABLE_ARG_SPAWN_MOTOR) end)
        end
        local t0 = os.clock()
        repeat
            task.wait(0.15)
            bike = FindMyBikeAuto()
        until bike or (os.clock() - t0) > 5
        if not bike then
            print("AutoSit: bike not spawned")
            return false
        end
        FarmState.BikeSpawned = true
    end

    local seat = FindDriveSeat(bike)
    if not seat or not IsDriverSeat(seat) then
        print("AutoSit: no driver seat")
        return false
    end

    _MotorState.bike = bike
    _MotorState.seat = seat

    local targetPos = seat.Position + Vector3.new(0, 2, 0)
    local dir = hrp.Position - seat.Position
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude > 0.1 then
        targetPos = targetPos + dir.Unit * SIDE_OFFSET
    end

    hrp.CFrame = CFrame.new(targetPos)
    task.wait(WALK_BEFORE_SIT_DURATION)

    local prompt = seat:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt then
        for _, d in ipairs(seat:GetDescendants()) do
            if d:IsA("ProximityPrompt") then prompt = d break end
        end
    end

    if prompt then
        InteractPromptNormal(prompt, HOLD_DURATION)
    else
        pcall(function() hum.Sit = true end)
    end

    task.wait(0.5)

    local okSit = false
    local t1 = os.clock()
    repeat
        task.wait(0.1)
        if hum.SeatPart and hum.SeatPart == seat then
            okSit = true
            break
        end
    until (os.clock() - t1) > 3

    if not okSit then
        _MotorState.bike = nil
        _MotorState.seat = nil
        print("AutoSit: failed to sit")
        return false
    end

    RecaptureMotorRotation()
    LockMotorPosition()

    _MotorState.seat = hum.SeatPart
    _MotorState.bike = hum.SeatPart.Parent
    FarmState.BikeSitting = true
    FarmState.BikeSpawned = true

    print("AutoSit: ok")
    return true
end

getgenv().AutoSitMotor = AutoSitMotor

