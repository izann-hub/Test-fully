local ScreenCover = { Enabled = false, Gui = nil, Frame = nil, Thread = nil }

local function ToggleScreenCover()
    if ScreenCover.Enabled then
        ScreenCover.Enabled = false
        if ScreenCover.Thread then
            pcall(function() task.cancel(ScreenCover.Thread) end)
            ScreenCover.Thread = nil
        end
        if ScreenCover.Gui then
            pcall(function() ScreenCover.Gui:Destroy() end)
            ScreenCover.Gui = nil
            ScreenCover.Frame = nil
        end
        print("Screen Cover: OFF")
        return false
    else
        ScreenCover.Enabled = true
        local gui = Instance.new("ScreenGui")
        gui.Name = "JenowaScreenCover"
        gui.ResetOnSpawn = false
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 999998
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        local pOK = pcall(function() gui.Parent = UIParent end)
        if not pOK or not gui.Parent then pcall(function() gui.Parent = PlayerGui end) end

        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 0
        frame.ZIndex = 1
        frame.Parent = gui

        ScreenCover.Gui = gui
        ScreenCover.Frame = frame

        ScreenCover.Thread = task.spawn(function()
            pcall(function()
                TweenService:Create(frame, TweenInfo.new(0.5), {
                    BackgroundTransparency = 0,
                    BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                }):Play()
            end)
            task.wait(0.6)
            while ScreenCover.Enabled do
                pcall(function()
                    TweenService:Create(frame, TweenInfo.new(1), {
                        BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                    }):Play()
                end)
                task.wait(1)
