local isClosing = false

local function animExit()
    if isClosing then return end
    isClosing = true

    task.wait(0.1)

    TweenService:Create(topBar, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(redDivider, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(topTitle, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
    TweenService:Create(contentFrame, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(infoLabel, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
    TweenService:Create(statusLabel, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()

    for _, child in ipairs(contentFrame:GetChildren()) do
        if child:IsA("TextButton") then
            TweenService:Create(child, TweenInfo.new(0.3), {
                BackgroundTransparency = 1, TextTransparency = 1
            }):Play()
            local s = child:FindFirstChildOfClass("UIStroke")
            if s then TweenService:Create(s, TweenInfo.new(0.3), { Transparency = 1 }):Play() end
        end
    end

    task.wait(0.25)
    TweenService:Create(mainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1
    }):Play()
    TweenService:Create(mainStroke, TweenInfo.new(0.6), { Transparency = 1 }):Play()

    task.delay(0.7, function()
        if combatConn then combatConn:Disconnect() end
        if farmConn then farmConn:Disconnect() end
        for _, conn in ipairs(rainConns) do
            if conn then conn:Disconnect() end
        end
        screenGui:Destroy()
    end)
end

