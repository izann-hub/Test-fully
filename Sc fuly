local function createSlider(parentTab, text, accent, min, max, default, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, -8, 0, 56)
    holder.BackgroundColor3 = Palette.DarkGray
    holder.BorderSizePixel = 0
    holder.BackgroundTransparency = 1
    holder.ZIndex = 3
