-- ============================================================
-- 🔒 BIKE LOCK (TANPA WELD, LOOP 0.5s)
-- ============================================================
local function CleanupBikeLock()
    BikeLock.Enabled = false
    BikeLock.Seat = nil
end

local function StartBikeLock(seat)
    CleanupBikeLock()
    BikeLock.Seat = seat
    BikeLock.Enabled = true
    
    BikeLock.Thread = task.spawn(function()
        while BikeLock.Enabled do
            task.wait(0.5)  -- dari 0.1 → 0.5
            
            if not LP.Character then break end
            
            local hum = LP.Character:FindFirstChildOfClass("Humanoid")
            if not hum then break end
            if hum.Health <= 0 then break end
            if not seat or not seat.Parent then break end
            
            -- Hanya paksa sit, TANPA weld paksa
            if not hum.SeatPart then
                pcall(function()
                    hum.Sit = true
                end)
            end
        end
    end)
end

