-- 🛑 FORCE DISMOUNT
-- ============================================================
local function ForceDismount()
    CleanupBikeLock()
    local hum = GetHumanoid()
    if not hum then return end
    if hum.SeatPart then
        pcall(function() hum.Sit = false end)
        task.wait(1)
    end
end

-- ============================================================
-- 🚀 TELEPORT PAKAI TWEEN (BUKAN SET CFRAME)
-- ============================================================
local function TweenTeleport(targetPos, duration)
    duration = duration or 1.5
    
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local startCF = hrp.CFrame
    local endCF = CFrame.new(targetPos) * (startCF - startCF.Position)
    
    -- Anchor karakter
    local parts = {}
    for _, p in pairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            parts[p] = p.Anchored
            p.Anchored = true
        end
    end
    
    local tw = TweenService:Create(hrp, 
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = endCF })
    tw:Play()
    tw.Completed:Wait()
    
    -- Unanchor
    for p, orig in pairs(parts) do
        if p and p.Parent then
            p.Anchored = orig
            p.AssemblyLinearVelocity = Vector3.zero
        end
    end
    
    return true
end

-- ============================================================
-- 🚀 TELEPORT DEATH (PAKAI TWEEN, JANGAN SET CFRAME LANGSUNG)
-- ============================================================
local function TeleportDeath(targetPos)
    if not LP.Character then return false end
    
    local root = GetRoot()
    local hum = GetHumanoid()
    if not root or not hum then return false end
    
    -- Tween ke RESPAWN_WARP
    local char = LP.Character
    local parts = {}
    for _, p in pairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            parts[p] = p.Anchored
            p.Anchored = true
        end
    end
    
    local endCF = CFrame.new(RESPAWN_WARP)
    pcall(function()
        root.CFrame = endCF
    end)
    
    task.wait(0.3)
    
    pcall(function()
        hum.Health = 0
    end)
    
    -- Tunggu respawn
    local startT = os.clock()
    local respawned = false
    
    local conn
    conn = LP.CharacterAdded:Connect(function()
        respawned = true
    end)
    
    while os.clock() - startT < 8 do
        if respawned then break end
        local h = GetHumanoid()
        if h and h.Health > 0 then
            respawned = true
            break
        end
        task.wait(0.2)
    end
    
    if conn then pcall(function() conn:Disconnect() end) end
    
    if not respawned then
        print("⚠️ Respawn timeout")
        return false
    end
    
    task.wait(1)
    
    local newRoot = GetRoot()
    if not newRoot then return false end
    
    -- Tween ke target
    local newChar = LP.Character
    local newParts = {}
    for _, p in pairs(newChar:GetDescendants()) do
        if p:IsA("BasePart") then
            newParts[p] = p.Anchored
            p.Anchored = true
        end
    end
    
    local newStartCF = newRoot.CFrame
    local newEndCF = CFrame.new(targetPos) * (newStartCF - newStartCF.Position)
    
    local tw = TweenService:Create(newRoot, 
        TweenInfo.new(1.5, Enum.EasingStyle.Linear),
        { CFrame = newEndCF })
    tw:Play()
    tw.Completed:Wait()
    
    for p, orig in pairs(newParts) do
        if p and p.Parent then
            p.Anchored = orig
            p.AssemblyLinearVelocity = Vector3.zero
        end
    end
    
    task.wait(1)
    return true
end

-- ============================================================
-- 🔥 TWEEN TELEPORT VEHICLE
-- ============================================================
local isTeleporting = false

local function TweenTeleportVehicle(targetPos)
    if isTeleporting then return false end
    isTeleporting = true
    
    local success = pcall(function()
        local vehicle = GetVehicle()
        if not vehicle then error("No vehicle") end
        
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then error("No HRP") end
        
        local primaryPart = vehicle:FindFirstChild("DriveSeat") 
            or vehicle.PrimaryPart 
            or vehicle:FindFirstChildWhichIsA("BasePart")
        if not primaryPart then error("No primary part") end
        
        local startPos = primaryPart.Position
        local finalVector = Vector3.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
        
        -- Pakai tween sederhana (tidak 3 step)
        local vehicleParts = {}
        for _, part in pairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                vehicleParts[part] = part.Anchored
                part.Anchored = true
            end
        end
        
        local charParts = {}
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                charParts[part] = part.Anchored
                part.Anchored = true
            end
        end
        
        -- Tween vehicle
        local vehicleCF = primaryPart.CFrame
        local vehicleOffset = vehicleCF - vehicleCF.Position
        local targetCF = CFrame.new(finalVector) * vehicleOffset
        
        local charOffset = vehicleCF:ToObjectSpace(hrp.CFrame)
        local charTargetCF = targetCF * charOffset
        
        local tw1 = TweenService:Create(primaryPart, 
            TweenInfo.new(3, Enum.EasingStyle.Linear),
            { CFrame = targetCF })
        tw1:Play()
        tw1.Completed:Wait()
        
        -- Unanchor
        for part, orig in pairs(vehicleParts) do
            if part and part.Parent then
                part.Anchored = orig
                part.AssemblyLinearVelocity = Vector3.zero
            end
        end
        for part, orig in pairs(charParts) do
            if part and part.Parent then
                part.Anchored = orig
                part.AssemblyLinearVelocity = Vector3.zero
            end
        end
    end)
    
    isTeleporting = false
    return success
end

-- ============================================================
-- 🚀 TELEPORT AUTO DETECT (SKIP KALAU DEKAT)
-- ============================================================
local function TeleportTo(targetPos)
    -- Cek jarak dulu — kalau < 15 stud, skip teleport
    local root = GetRoot()
    if root then
        local dist = (root.Position - targetPos).Magnitude
        if dist < 15 then
            return true
        end
    end
    
    if IsOnBike() then
        local ok = TweenTeleportVehicle(targetPos)
        if ok then return true end
        
        ForceDismount()
        task.wait(1)
    end
    
    return TeleportDeath(targetPos)
end

