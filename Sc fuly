    pcall(function()
        newRoot.CFrame = CFrame.new(targetPos)
        newRoot.Velocity = Vector3.zero
        newRoot.AssemblyLinearVelocity = Vector3.zero
    end)
    
    task.wait(0.5)
    
    return true
