-- 🛡️ SAFE TELEPORT (RETRY 1x, JEDA PANJANG)
-- ============================================================
local function SafeTeleport(targetPos, label)
    label = label or "target"
    
    if not IsAlive() then
        local startT = os.clock()
        while not IsAlive() and os.clock() - startT < 8 do
            task.wait(0.5)
        end
    end
    
    local ok = TeleportTo(targetPos)
    task.wait(1.5)
    
    if IsAlive() then
        local root = GetRoot()
        if root and (root.Position - targetPos).Magnitude < 25 then
            return true
        end
    end
    
    print("⚠️ SafeTeleport " .. label .. " gagal")
    return false
end

