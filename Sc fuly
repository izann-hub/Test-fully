-- 🏍️ SPAWN + SIT ON BIKE (NON-AGGRESSIVE)
-- ============================================================
local function SpawnAndSitOnBike()
    local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
    if h and h.SeatPart then 
        print("✅ Already on bike!")
        FarmState.BikeSitting = true
        StartBikeLock(h.SeatPart)
        return true 
    end

    local bike = FindBike()
    
    if bike then
        print("✅ Bike sudah ada")
    else
        print("🎯 Teleport ke Dealer...")
        SafeTeleport(findClearSpot(Locations.Dealer, 10), "Dealer")
        task.wait(2)
        
        CloseAllDialogs()
        task.wait(1)
        
        -- HANYA 2 FORMAT, JEDA 3s
        local spawnFormats = {
            function() RPC:FireServer(BUY_DIRTBIKE, "Spawn", "DirtBike") end,
            function() RPC:FireServer(BUY_DIRTBIKE, "Spawn") end,
        }
        
        for i, fmt in ipairs(spawnFormats) do
            print("🔄 Coba spawn format #" .. i)
            pcall(fmt)
            task.wait(3)
            bike = FindBike()
            if bike then
                print("✅ Motor muncul")
                break
            end
        end
        
        if not bike then
            print("⚠️ Cari prompt spawn...")
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and IsSpawnPrompt(v) then
                    local parent = v.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - Locations.Dealer).Magnitude
                        if dist < 50 then
                            pcall(function()
                                v.MaxActivationDistance = 9999
                                v.RequiresLineOfSight = false
                                v.HoldDuration = 0
                                fireproximityprompt(v)
                            end)
                            task.wait(3)
                            bike = FindBike()
                            if bike then break end
                        end
                    end
                end
            end
        end
        
        if not bike then
            local startT = os.clock()
            while os.clock() - startT < 15 do
                bike = FindBike()
                if bike then break end
                task.wait(1)
            end
        end
    end

    if not bike then 
        print("❌ Bike tidak muncul")
        return false 
    end
    
    print("✅ Bike found:", bike.Name)

    local ds = bike:FindFirstChild("DriveSeat") 
        or bike:FindFirstChildWhichIsA("Seat")
        or bike:FindFirstChild("Seat", true)
    if not ds then 
        print("❌ DriveSeat not found!")
        return false 
    end
    
    print("🪑 DriveSeat:", ds.Name)

    CloseAllDialogs()
    task.wait(1)

    -- Anchor motor
    local vehicleParts = {}
    for _, part in pairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            vehicleParts[part] = part.Anchored
            part.Anchored = true
        end
    end
    task.wait(1)

    -- Tween karakter ke motor
    local tp = ds.CFrame * CFrame.new(0, 3, 0)
    print("🐢 Tween ke motor...")
    TweenTeleport(tp.Position, 2)
    task.wait(1)

    -- Cari prompt di DriveSeat
    local prom = ds:FindFirstChildWhichIsA("ProximityPrompt", true)

    -- HANYA 2 RETRY, JEDA 1s
    local maxRetry = 2
    for attempt = 1, maxRetry do
        print("🔄 Attempt sit #" .. attempt)
        
        local root = LP.Character:FindFirstChild("HumanoidRootPart")
        if root and ds then
            pcall(function()
                root.CFrame = ds.CFrame * CFrame.new(0, 0.5, 0)
                root.Velocity = Vector3.zero
            end)
        end
        task.wait(0.5)
        
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.Sit = true
                hum.Jump = false
            end)
        end
        task.wait(1)
        
        hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart then
            print("✅ Berhasil duduk!")
            
            -- Unanchor motor
            for part, orig in pairs(vehicleParts) do
                if part and part.Parent then
                    part.Anchored = orig
                end
            end
            
            FarmState.BikeSitting = true
            FarmState.BikeSpawned = true
            
            StartBikeLock(ds)
            return true
        end
        
        if prom then
            prom.HoldDuration = 0
            prom.RequiresLineOfSight = false
            prom.MaxActivationDistance = 9e9
            pcall(function() fireproximityprompt(prom) end)
            task.wait(1)
            
            hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                print("✅ Berhasil duduk via prompt!")
                
                for part, orig in pairs(vehicleParts) do
                    if part and part.Parent then
                        part.Anchored = orig
                    end
                end
                
                FarmState.BikeSitting = true
                FarmState.BikeSpawned = true
                
                StartBikeLock(ds)
                return true
            end
        end
    end

    -- Gagal — unanchor
    for part, orig in pairs(vehicleParts) do
        if part and part.Parent then
            part.Anchored = orig
        end
    end

    print("❌ Gagal duduk")
    return false
end

