-- ==============================
local function createButton(text, order, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 34)
    btn.Position = UDim2.new(0, 10, 0, 50 + (order * 42))
    btn.BackgroundColor3 = COLOR_PINK_DARK
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = COLOR_TEXT
    btn.TextTransparency = 1
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.ZIndex = 3
    btn.Parent = contentFrame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn

    local s = Instance.new("UIStroke")
    s.Color = COLOR_PINK
    s.Thickness = 1
    s.Transparency = 1
    s.Parent = btn

    local ts = Instance.new("UITextSizeConstraint")
    ts.MaxTextSize = 16
    ts.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = COLOR_PINK }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = COLOR_PINK_DARK }):Play()
    end)
    btn.MouseButton1Click:Connect(function()
        if isClosing then return end
        btn.BackgroundColor3 = COLOR_BLUE
        task.delay(0.1, function()
            if callback then callback() end
            animExit()
        end)
    end)

    return btn
end

