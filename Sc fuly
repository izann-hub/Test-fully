-- ============================================================
-- 🍳 COOK — TANPA TELEPORT
-- ============================================================
local function CookMarshmallow(amount, skipBuy)
    amount = amount or FarmSettings.Amount
    FarmState.BatchProgress = "0/" .. amount
    FarmState.CurrentBatch = 0

    if not skipBuy then
        FarmState.Step = "🛒 Buying Ingredients"
        local buySuccess = false
        for retry = 1, 5 do
            buySuccess = BuyAll(amount)
            if buySuccess then break end
            task.wait(2)
        end
        if not buySuccess then
            print("⚠️ Buy failed, skip cycle")
            task.wait(3)
            return true
        end
        task.wait(0.5)
    end

    FarmState.Step = "🍳 Finding Pot"
    local Pot, dist = findNearestPot()
    if not Pot then
        print("⚠️ Pot not found, skip cycle")
        task.wait(3)
        return true
    end
    
    print("🍳 Pot found at distance: " .. math.floor(dist))

    local PotPrompt = getPotPrompt(Pot)
    if not PotPrompt then
        print("⚠️ Prompt not found, skip cycle")
        task.wait(3)
        return true
    end

    EnableNoClip()

    for i = 1, amount do
        if StopRequest then return false end
        FarmState.CurrentBatch = i
        FarmState.BatchProgress = i .. "/" .. amount

        -- WATER
        FarmState.Step = "💧 Water (" .. i .. "/" .. amount .. ")"
        if af_Equip("Water") then
            task.wait(0.3)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end
        local timeout = 0
        while timeout < 21 do
            if StopRequest then return false end
            local timer = Pot:FindFirstChild("Timer")
            if timer and timer:IsA("TextLabel") and timer.Text == "0" then break end
            task.wait(0.5)
            timeout = timeout + 0.5
        end

        -- SUGAR
        FarmState.Step = "🧂 Sugar (" .. i .. "/" .. amount .. ")"
        if af_Equip("Sugar Block Bag") then
            task.wait(0.3)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end
        timeout = 0
        while timeout < 2 do
            if StopRequest then return false end
            local timer = Pot:FindFirstChild("Timer")
            if timer and timer:IsA("TextLabel") and timer.Text == "0" then break end
            task.wait(0.5)
            timeout = timeout + 0.5
        end

        -- GELATIN
        FarmState.Step = "🧪 Gelatin (" .. i .. "/" .. amount .. ")"
        if af_Equip("Gelatin") then
            task.wait(0.3)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end
        timeout = 0
        while timeout < 46 do
            if StopRequest then return false end
            local timer = Pot:FindFirstChild("Timer")
            if timer and timer:IsA("TextLabel") and timer.Text == "0" then break end
            task.wait(0.5)
            timeout = timeout + 0.5
        end

        -- EMPTY BAG
        FarmState.Step = "🛍️ Collect (" .. i .. "/" .. amount .. ")"
        if af_Equip("Empty Bag") then
            task.wait(0.3)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end

        FarmState.MarshmallowsMade = FarmState.MarshmallowsMade + 1
        UpdateCashTracker()
    end

    return true
end

-- ============================================================
-- 💰 SELL — TANPA TELEPORT
-- ============================================================
local function SellMarshmallow()
    FarmState.Step = "💰 Selling"
    local lamont = findLamont()
    if not lamont then
        print("⚠️ Lamont not found")
        return false
    end
    local sellP = lamont:FindFirstChild("UpperTorso") and lamont.UpperTorso:FindFirstChildOfClass("ProximityPrompt")
    if not sellP then
        print("⚠️ Sell prompt not found")
        return false
    end
    local sold = 0
    if Player.Backpack then
        for _, v in pairs(Player.Backpack:GetChildren()) do
            if StopRequest then break end
            if v:IsA("Tool") and v.Name:find("Marshmallow") then
                local hum2 = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
                if hum2 then pcall(function() hum2:EquipTool(v) end) end
                af_FirePrompt(sellP)
                sold = sold + 1
                FarmState.Sold = FarmState.Sold + 1
                task.wait(0.25)
            end
        end
    end
    UpdateCashTracker()
    return sold > 0
end

-- ============================================================
-- 🔄 FULL CYCLE
-- ============================================================
local CurrentCycle = 0

local function FullCycle()
    FarmState.BatchProgress = "0/" .. FarmSettings.Amount
    FarmState.CurrentBatch = 0

    local cookSuccess = CookMarshmallow(FarmSettings.Amount, false)
    if not cookSuccess then
        task.wait(5)
        return true
    end

    DisableNoClip()
    SellMarshmallow()
    task.wait(0.5)

    CurrentCycle = CurrentCycle + 1
    FarmState.Cycles = CurrentCycle
    UpdateCashTracker()
    return true
end

-- ============================================================
-- 🚀 START/STOP
-- ============================================================
local function StartFullyFarm()
    if FarmRunning then return end
    FarmRunning = true
    StopRequest = false
    CurrentCycle = 0
    FarmState.Cycles = 0
    FarmState.Sold = 0
    FarmState.MarshmallowsMade = 0
    FarmState.Step = "Starting"
    StartRGBName()
    FarmThread = task.spawn(function()
        while FarmRunning and not StopRequest do
            FullCycle()
            task.wait(1)
        end
        FarmRunning = false
        FarmState.Step = "Idle"
        StopRGBName()
    end)
end

local function StopFullyFarm()
    StopRequest = true
    FarmRunning = false
    FarmState.Step = "Idle"
    StopRGBName()
    if FarmThread then task.cancel(FarmThread) FarmThread = nil end
end

_G.StartFullyFarm = StartFullyFarm
_G.StopFullyFarm = StopFullyFarm

