-- ===================== INSTA-INTERACT =====================
local function applyInsta()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if not modifiedPrompts[v] then
                modifiedPrompts[v] = v.HoldDuration
            end
            v.HoldDuration = 0
        end
    end
    holdConnection = PPS.PromptButtonHoldBegan:Connect(function(v)
        if not modifiedPrompts[v] then
            modifiedPrompts[v] = v.HoldDuration
        end
        v.HoldDuration = 0
    end)
end

local function removeInsta()
    if holdConnection then
        holdConnection:Disconnect()
        holdConnection = nil
    end
    for prompt, original in pairs(modifiedPrompts) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = original
        end
    end
    modifiedPrompts = {}
end

-- ===================== HITBOX KEPALA =====================
local HITBOX_SIZE = Vector3.new(15, 15, 15)

local function expandHead(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head or not head:IsA("BasePart") then return end
    if not originalHead[player] then
        originalHead[player] = {
            Size = head.Size,
            Transparency = head.Transparency,
            CanCollide = head.CanCollide,
            Massless = head.Massless
        }
    end
    head.Size = HITBOX_SIZE
    head.Transparency = 0.5
    head.CanCollide = false
    head.Massless = true
end

local function restoreHead(player)
    local data = originalHead[player]
    if not data then return end
    local char = player.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        head.Size = data.Size
        head.Transparency = data.Transparency
        head.CanCollide = data.CanCollide
        head.Massless = data.Massless
    end
    originalHead[player] = nil
end

local function bindPlayer(player)
    if player == LocalPlayer then return end

    local function onChar(char)
        task.wait(0.5)
        if hitboxEnabled then
            expandHead(player)
        end
    end

    if player.Character then
        task.spawn(function() onChar(player.Character) end)
    end

    local conn = player.CharacterAdded:Connect(function(char)
        onChar(char)
    end)
    table.insert(playerConnections, conn)
end

local function applyHitboxAll()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            expandHead(player)
        end
    end
end

local function restoreHitboxAll()
    for player, _ in pairs(originalHead) do
        restoreHead(player)
    end
    originalHead = {}
end

-- Bind semua player
for _, player in ipairs(Players:GetPlayers()) do
    bindPlayer(player)
end

Players.PlayerAdded:Connect(bindPlayer)

Players.PlayerRemoving:Connect(function(player)
    originalHead[player] = nil
end)

