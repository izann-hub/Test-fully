local combatActive = false
local combatConn = nil

local function toggleCombat()
    combatActive = not combatActive

    if combatActive then
        statusLabel.Text = "STATUS: COMBAT AKTIF"
        statusLabel.TextColor3 = COLOR_RED

        combatConn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end

            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= player and other.Character then
                    local oRoot = other.Character:FindFirstChild("HumanoidRootPart")
                    local oHum = other.Character:FindFirstChild("Humanoid")
                    if oRoot and oHum and oHum.Health > 0 then
                        if (root.Position - oRoot.Position).Magnitude < 15 then
                            root.CFrame = CFrame.new(oRoot.Position + Vector3.new(0, 0, 3))
                        end
                    end
                end
            end
        end)
    else
        statusLabel.Text = "STATUS: IDLE"
        statusLabel.TextColor3 = COLOR_TEXT
        if combatConn then combatConn:Disconnect(); combatConn = nil end
    end
end

