local function FindAvailableATMs()
    local map = Workspace:FindFirstChild("Map")
    if not map then return nil end
    
    local atmsFolder = map:FindFirstChild("ATMS")
    if not atmsFolder then return nil end
    
    for _, atm in pairs(atmsFolder:GetChildren()) do
        if atm.Name:match("ATM") then
            local screen = atm:FindFirstChild("ATMScreen")
            if screen and screen.Transparency == 0 then
                return atm
            end
        end
    end
    
    return nil
end

