-- ============================================================
-- UTIL: CARI TARGET
-- ============================================================
local function GetTarget()
    local mousePos = UserInputService:GetMouseLocation()
    local closest, closestDist = nil, _G.FOVRadius

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild(_G.AimPart)
            if hum and part and hum.Health > 0 then
                if not _G.TeamCheck or plr.Team ~= LocalPlayer.Team then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = part
                        end
                    end
                end
            end
        end
    end

    return closest
end

-- ============================================================
-- UTIL: PATCH ARGUMEN
-- ============================================================
local function PatchArgs(args, origin, targetPos)
    if type(args[1]) == "table" then
        local t = args[1]
        if t.Origin and t.Direction then
            t.Direction = (targetPos - t.Origin).Unit
            return args
        end
        if t.CFrame then
            t.CFrame = CFrame.lookAt(origin, targetPos)
            return args
        end
    end
    if type(args[1]) == "Vector3" and type(args[2]) == "Vector3" then
        args[2] = (targetPos - args[1]).Unit
        return args
    end
    if typeof(args[1]) == "CFrame" then
        args[1] = CFrame.lookAt(args[1].Position, targetPos)
        return args
    end
    return args
end

-- ============================================================
-- HOOK __namecall
-- ============================================================
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()

    if _G.SilentAim and method == "FireServer" and validRemotes[self.Name] then
        local target = GetTarget()
        if target then
            local origin = Camera.CFrame.Position
            local targetPos = target.Position
            local args = {...}
            args = PatchArgs(args, origin, targetPos)
            return oldNamecall(self, unpack(args))
        end
    end

    return oldNamecall(self, ...)
end)

