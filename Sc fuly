    drop.Position = UDim2.new(math.random(), 0, -0.1, 0)
    drop.BackgroundColor3 = COLOR_RAIN
    drop.BackgroundTransparency = math.random(30, 70) / 100
    drop.BorderSizePixel = 0
    drop.ZIndex = 0
    drop.Parent = rainContainer

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = drop

    local speed = math.random(80, 150) / 100
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not drop.Parent then conn:Disconnect() return end
        drop.Position = UDim2.new(drop.Position.X.Scale, 0, drop.Position.Y.Scale + (speed * 0.008), 0)
        if drop.Position.Y.Scale > 1.1 then
            drop.Position = UDim2.new(math.random(), 0, -0.1, 0)
        end
    end)

    table.insert(rainDrops, drop)
    table.insert(rainConns, conn)
end

