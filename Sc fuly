local function loadBypass()
    if bypassLoaded then return end
    pcall(function()
        -- Metode 1: Hook kick
        local oldKick
        oldKick = hookfunction(localPlayer.Kick, function(self, reason)
            warn("[Bypass] Kick attempt blocked: " .. tostring(reason))
            return
        end)
    end)
    pcall(function()
        -- Metode 2: Anti-Idle & Anti-Kick
        for _, v in ipairs(getconnections(localPlayer.Idled)) do
            v:Disconnect()
        end
    end)
    pcall(function()
        -- Metode 3: Blokir remote event pemanggil kick
        for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                if v.Name:lower():find("kick") or v.Name:lower():find("ban") then
                    v:Destroy()
                end
            end
        end
    end)
    bypassLoaded = true
    print("[Dark Angel] Bypass Loaded & Active.")
end

