-- AddToggle
--=============================================================
local function AddToggle(name, default, callback)
    default = default or false
    callback = callback or function() end
    local state = {value = default}
    local Row = Instance.new("Frame")
    Row.Name = name
    Row.Size = UDim2.new(1, -6, 0, 46)
    Row.BackgroundColor3 = C_ROW
    Row.BorderSizePixel = 0
    Row.Parent = Container
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 8)
    local rs = Instance.new("UIStroke", Row)
    rs.Color = C_WHITE rs.Thickness = 1 rs.Transparency = 0.85

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -80, 1, 0)
    Label.Position = UDim2.new(0, 14, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 14
    Label.TextColor3 = C_TEXT
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row

    local Track = Instance.new("TextButton")
    Track.Size = UDim2.new(0, 50, 0, 26)
    Track.Position = UDim2.new(1, -62, 0.5, -13)
    Track.BackgroundColor3 = default and C_WHITE or C_TRACK_OFF
    Track.BorderSizePixel = 0
    Track.Text = ""
    Track.AutoButtonColor = false
    Track.Parent = Row
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local ts = Instance.new("UIStroke", Track)
    ts.Color = C_WHITE ts.Thickness = 1 ts.Transparency = default and 0 or 0.7

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 22, 0, 22)
    Knob.Position = default and UDim2.new(1, -24, 0, 2) or UDim2.new(0, 2, 0, 2)
    Knob.BackgroundColor3 = C_WHITE
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 2
    Knob.Parent = Track
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    local function setState(value, fire)
        state.value = value
        if value then
            TweenService:Create(Track, TweenInfo.new(0.2), {BackgroundColor3 = C_WHITE}):Play()
            TweenService:Create(ts, TweenInfo.new(0.2), {Transparency = 0}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -24, 0, 2)}):Play()
        else
            TweenService:Create(Track, TweenInfo.new(0.2), {BackgroundColor3 = C_TRACK_OFF}):Play()
            TweenService:Create(ts, TweenInfo.new(0.2), {Transparency = 0.7}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0, 2)}):Play()
        end
        if fire then callback(state.value) end
    end

    Track.MouseButton1Click:Connect(function() setState(not state.value, true) end)
    return {Set = function(v) setState(v, true) end, Get = function() return state.value end}
end

--=============================================================
-- AddSlider
--=============================================================
local function AddSlider(name, min, max, default, callback)
    min = min or 1
    max = max or 100
    default = default or min
    callback = callback or function() end
    local value = default

    local Row = Instance.new("Frame")
    Row.Name = name
    Row.Size = UDim2.new(1, -6, 0, 60)
    Row.BackgroundColor3 = C_ROW
    Row.BorderSizePixel = 0
    Row.Parent = Container
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 8)
    local rs = Instance.new("UIStroke", Row)
    rs.Color = C_WHITE rs.Thickness = 1 rs.Transparency = 0.85

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -60, 0, 22)
    Label.Position = UDim2.new(0, 14, 0, 6)
    Label.BackgroundTransparency = 1
    Label.Text = name
    Label.Font = Enum.Font.Gotham
    Label.TextSize = 14
    Label.TextColor3 = C_TEXT
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Row

    local ValueLabel = Instance.new("TextLabel")
    ValueLabel.Size = UDim2.new(0, 50, 0, 22)
    ValueLabel.Position = UDim2.new(1, -60, 0, 6)
    ValueLabel.BackgroundTransparency = 1
    ValueLabel.Text = tostring(default)
    ValueLabel.Font = Enum.Font.GothamBold
    ValueLabel.TextSize = 14
    ValueLabel.TextColor3 = C_WHITE
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.Parent = Row

    local SliderBar = Instance.new("Frame")
    SliderBar.Name = "SliderBar"
    SliderBar.Size = UDim2.new(1, -28, 0, 8)
    SliderBar.Position = UDim2.new(0, 14, 0, 38)
    SliderBar.BackgroundColor3 = C_TRACK_OFF
    SliderBar.BorderSizePixel = 0
    SliderBar.Parent = Row
    Instance.new("UICorner", SliderBar).CornerRadius = UDim.new(1, 0)

    local Fill = Instance.new("Frame")
    Fill.Name = "Fill"
    Fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    Fill.BackgroundColor3 = C_WHITE
    Fill.BorderSizePixel = 0
    Fill.Parent = SliderBar
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Name = "Knob"
    Knob.Size = UDim2.new(0, 16, 0, 16)
    Knob.AnchorPoint = Vector2.new(0.5, 0.5)
    Knob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
    Knob.BackgroundColor3 = C_WHITE
    Knob.BorderSizePixel = 0
    Knob.ZIndex = 2
    Knob.Parent = SliderBar
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    local ks = Instance.new("UIStroke", Knob)
    ks.Color = C_WHITE ks.Thickness = 1 ks.Transparency = 0

    local dragging = false

    local function updateFromInput(input)
        local barPos = SliderBar.AbsolutePosition.X
        local barSize = SliderBar.AbsoluteSize.X
        local relative = math.clamp((input.Position.X - barPos) / barSize, 0, 1)
        local newValue = math.floor(min + (max - min) * relative + 0.5)
        value = newValue
        Fill.Size = UDim2.new(relative, 0, 1, 0)
        Knob.Position = UDim2.new(relative, 0, 0.5, 0)
        ValueLabel.Text = tostring(newValue)
        callback(newValue)
    end

    SliderBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromInput(input)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Set = function(v)
            v = math.clamp(v, min, max)
            value = v
            local rel = (v - min) / (max - min)
            Fill.Size = UDim2.new(rel, 0, 1, 0)
            Knob.Position = UDim2.new(rel, 0, 0.5, 0)
            ValueLabel.Text = tostring(v)
            callback(v)
        end,
        Get = function() return value end
    }
end

