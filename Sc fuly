local function GetCurrentCash()
    local total = 0
    local ls = Player:FindFirstChild("leaderstats")
    if ls then
        for _, stat in pairs(ls:GetChildren()) do
            pcall(function()
                if type(stat.Value) == "number" then total = total + stat.Value end
            end)
        end
    end
    return math.floor(total)
