-- ===================== BYPASS (RINGAN) =====================
task.spawn(function()
    task.wait(1)

    local has = function(n) return type(_G[n]) == "function" end
    if not (has("hookmetamethod") and has("getrawmetatable")) then return end

    -- Blok Kick
    pcall(function()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        local wrap = newcclosure or function(f) return f end

        setreadonly(mt, false)
        mt.__namecall = wrap(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" and self == LocalPlayer and not checkcaller() then
                return
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
    end)

    -- Neutralize Detected func (limit scan)
    pcall(function()
        if not has("getgc") or not has("hookfunction") then return end
        local count = 0
        local target = nil

        for _, v in next, getgc(true) do
            count = count + 1
            if count > 200 then break end
            if typeof(v) == "table" then
                local d = rawget(v, "Detected")
                if typeof(d) == "function" then
                    target = d
                    break
                end
            end
        end

        if target then
            hookfunction(target, function(...)
                task.wait(9e9)
            end)
        end
    end)
end)

