local spin_bot = {
    Enabled = false,
    Speed = 360,
    Mode = "Continuous",
}

local function ApplySpinBot()
    if not spin_bot.Enabled then return end

    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return end

    local moveDirection = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then 
        moveDirection = moveDirection + Camera.CFrame.LookVector 
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then 
        moveDirection = moveDirection - Camera.CFrame.LookVector 
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then 
        moveDirection = moveDirection - Camera.CFrame.RightVector 
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then 
        moveDirection = moveDirection + Camera.CFrame.RightVector 
    end

    if moveDirection.Magnitude > 0 then
        moveDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z).Unit
    end

    local delta = RunService.Heartbeat:Wait()
    local speed = spin_bot.Speed * delta

    local currentCFrame = hrp.CFrame
    local _, currentY, _ = currentCFrame:ToOrientation()
    local newY = currentY + math.rad(speed)

    if spin_bot.Mode == "Continuous" then
        hrp.CFrame = CFrame.new(currentCFrame.Position) * CFrame.Angles(0, newY, 0)
    elseif spin_bot.Mode == "Jitter" then
        local angle = math.sin(tick() * 10) * math.rad(speed * 0.5)
        hrp.CFrame = CFrame.new(currentCFrame.Position) * CFrame.Angles(0, currentY + angle, 0)
    elseif spin_bot.Mode == "Random" then
        if math.random(1, 5) == 1 then
            hrp.CFrame = CFrame.new(currentCFrame.Position) * CFrame.Angles(0, currentY + math.rad(math.random(-speed, speed)), 0)
        end
    end

    if moveDirection.Magnitude > 0 then
        local speedValue = hybrid_speed_enabled and hybrid_speed_value or 16
        hrp.Velocity = Vector3.new(moveDirection.X * speedValue, hrp.Velocity.Y, moveDirection.Z * speedValue)
    else
        hrp.Velocity = Vector3.new(0, hrp.Velocity.Y, 0)
    end

    hrp.AssemblyAngularVelocity = Vector3.zero
    hum.AutoRotate = false
end

