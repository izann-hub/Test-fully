-- ============================================================
-- TWEEN KE BIKE
-- ============================================================
local function TweenToBike(targetPos, duration)
    duration = duration or 3
    
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local startPos = hrp.Position
    local dist = (targetPos - startPos).Magnitude
    
    local speed = SIT_BIKE_TWEEN_SPEED
    local calculatedDuration = math.clamp(dist / speed, 1, 10)
    
    local style = Enum.EasingStyle.Linear
    local dir = Enum.EasingDirection.Out
    
    local charParts = {}
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            charParts[part] = {
                Anchored = part.Anchored,
                CFrame = part.CFrame
            }
            part.Anchored = true
        end
    end
    
    local tweens = {}
    local startCF = hrp.CFrame
    local offset = CFrame.new(targetPos) * (startCF - startCF.Position) - startCF
    
    for part, data in pairs(charParts) do
        if part and part.Parent then
            local targetCF = data.CFrame + offset.Position
            local t = TweenService:Create(part, 
                TweenInfo.new(calculatedDuration, style, dir),
                { CFrame = targetCF })
            table.insert(tweens, t)
        end
    end
    
    for _, t in ipairs(tweens) do t:Play() end
    if tweens[1] then tweens[1].Completed:Wait() end
    
    for part, data in pairs(charParts) do
        if part and part.Parent then
            part.Anchored = data.Anchored
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
    
    return true
end

