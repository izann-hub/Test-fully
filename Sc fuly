                            gv.T1 = a[1][1]; gv.T2 = a[1][2]
                            gv.T3 = a[1][6]; gv.T4 = a[1][11]
                        end
                        return o(s, ...)
                    end)
                end
            end)
            if bit32 and bit32.bxor and gv.Hyphon_Script and checkcaller and getcallingscript then
