    bp.MaxForce = Vector3.new(4000, 4000, 4000)
    bp.P = 2000
    bp.D = 100
    bp.Position = cookPos.Position
    local bg = Instance.new("BodyGyro")
    bg.Name = "FlyLock"
    bg.Parent = hrp
    bg.MaxTorque = Vector3.new(4000, 4000, 4000)
    bg.P = 2000
    bg.D = 100
    bg.CFrame = hrp.CFrame
    return true
