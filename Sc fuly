local function get_silent_target(fov_pos)
    local best, best_d = nil, math.huge
    local vp = Camera.ViewportSize
    local origin = silent_mode == "HP" and Vector2.new(vp.X / 2, vp.Y / 2) or fov_pos
    
    for _, p in pairs(Players:GetPlayers()) do
        if p == Player then continue end
        if not sa_is_allowed(p) then continue end
        
        local ch = p.Character
        if not ch then continue end
        
        local hrp = ch:FindFirstChild("HumanoidRootPart")
        local hum = ch:FindFirstChildOfClass("Humanoid")
        local hit = ch:FindFirstChild(silent_part)
        
        if not hrp or not hum or not hit or hum.Health <= 0 then continue end
        
        local sp, on_screen = Camera:WorldToViewportPoint(hit.Position)
        if not on_screen then continue end
        
        local screenPos = Vector2.new(sp.X, sp.Y)
        local d = (origin - screenPos).Magnitude
        
        if d < fov_radius and d < best_d then 
            best = p
            best_d = d 
        end
    end
    return best
end

local function IsTargetVisible(targetPart, origin)
    if not targetPart then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {Player.Character}
    local ray = workspace:Raycast(origin, (targetPart.Position - origin).Unit * 999, params)
    if ray then
        local hit = ray.Instance
        if hit and hit:IsDescendantOf(targetPart.Parent) then
            return true
        end
        return false
    end
    return true
end

