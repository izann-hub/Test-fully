-- ============================================
-- SCRIPT TERBANG BERSAMA MOBIL + UI + OFF
-- Executor: CDID
-- ============================================

task.wait(1)

-- [ SERVICE ]
local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local UIS         = game:GetService("UserInputService")

local LP = Players.LocalPlayer
if not LP then warn("[CDID] LP tidak ada") return end

-- ============================================
-- [ UI DULU — BIAR PASTI MUNCUL ]
-- ============================================
local gui = Instance.new("ScreenGui")
gui.Name = "CDID_Terbang"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

-- coba parent ke CoreGui dulu, kalau gagal ke PlayerGui
local sukses = pcall(function()
    gui.Parent = game:GetService("CoreGui")
end)
if not sukses then
    gui.Parent = LP:WaitForChild("PlayerGui")
end

print("[CDID] UI dibuat")

-- Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 190, 0, 240)
frame.Position = UDim2.new(0, 20, 0.4, 0)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local c1 = Instance.new("UICorner")
c1.CornerRadius = UDim.new(0, 8)
c1.Parent = frame

local judul = Instance.new("TextLabel")
judul.Size = UDim2.new(1, 0, 0, 30)
judul.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
judul.BorderSizePixel = 0
judul.Text = "TERBANG + MOBIL"
judul.TextColor3 = Color3.fromRGB(220, 220, 220)
judul.Font = Enum.Font.GothamBold
judul.TextSize = 14
judul.Parent = frame

local c2 = Instance.new("UICorner")
c2.CornerRadius = UDim.new(0, 8)
c2.Parent = judul

local function buatTombol(teks, warna, y)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -20, 0, 35)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = warna
    b.BorderSizePixel = 0
    b.Text = teks
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Parent = frame

    local cc = Instance.new("UICorner")
    cc.CornerRadius = UDim.new(0, 6)
    cc.Parent = b

    return b
end

local btnNaik  = buatTombol("NAIK (V)",  Color3.fromRGB(50, 120, 60), 40)
local btnTurun = buatTombol("TURUN (Z)", Color3.fromRGB(120, 50, 50), 80)
local btnOff   = buatTombol("OFF",       Color3.fromRGB(90, 90, 90),  120)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 25)
status.Position = UDim2.new(0, 10, 0, 160)
status.BackgroundTransparency = 1
status.Text = "Status: Mencari mobil..."
status.TextColor3 = Color3.fromRGB(180, 180, 180)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.Parent = frame

-- ============================================
-- [ KONFIGURASI ]
-- ============================================
local KECEPATAN   = 80
local NAIK_SPEED  = 40
local TURUN_SPEED = 40
local OFFSET_X    = 0
local OFFSET_Y    = -3
local OFFSET_Z    = 0
local MOBIL_NAMA  = "Vehicle"

-- ============================================
-- [ CARI KARAKTER ]
-- ============================================
local CHAR = LP.Character or LP.CharacterAdded:Wait()
local HRP  = CHAR:WaitForChild("HumanoidRootPart", 10)

if not HRP then
    status.Text = "Status: HRP tidak ada"
    warn("[CDID] HRP tidak ada")
    return
end

-- ============================================
-- [ CARI MOBIL ]
-- ============================================
local mobil = workspace:FindFirstChild(MOBIL_NAMA)

if not mobil then
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("VehicleSeat") then
            mobil = v
            break
        end
    end
end

if not mobil then
    status.Text = "Status: Mobil tidak ada"
    warn("[CDID] Mobil tidak ada — tekan NAIK untuk terbang saja")
end

-- [ CARI PART MOBIL ]
local mobilPart
if mobil then
    for _, v in pairs(mobil:GetDescendants()) do
        if v:IsA("BasePart") then
            mobilPart = v
            break
        end
    end
    if mobilPart then
        status.Text = "Status: Aktif — " .. mobil.Name
    end
else
    status.Text = "Status: Aktif (tanpa mobil)"
end

-- [ SIMPAN POSISI AWAL ]
local posAwalHRP   = HRP.CFrame
local posAwalMobil = mobilPart and mobilPart.CFrame or nil

-- ============================================
-- [ VARIABEL ]
-- ============================================
local naik  = false
local turun = false
local aktif = true

-- ============================================
-- [ EFEK TOMBOL ]
-- ============================================
btnNaik.MouseButton1Down:Connect(function()
    naik = true
    btnNaik.BackgroundColor3 = Color3.fromRGB(80, 180, 90)
end)
btnNaik.MouseButton1Up:Connect(function()
    naik = false
    btnNaik.BackgroundColor3 = Color3.fromRGB(50, 120, 60)
end)
btnNaik.MouseLeave:Connect(function()
    naik = false
    btnNaik.BackgroundColor3 = Color3.fromRGB(50, 120, 60)
end)

btnTurun.MouseButton1Down:Connect(function()
    turun = true
    btnTurun.BackgroundColor3 = Color3.fromRGB(180, 80, 80)
end)
btnTurun.MouseButton1Up:Connect(function()
    turun = false
    btnTurun.BackgroundColor3 = Color3.fromRGB(120, 50, 50)
end)
btnTurun.MouseLeave:Connect(function()
    turun = false
    btnTurun.BackgroundColor3 = Color3.fromRGB(120, 50, 50)
end)

-- ============================================
-- [ OFF ]
-- ============================================
local fungsiTerbang

btnOff.MouseButton1Click:Connect(function()
    aktif = false
    naik  = false
    turun = false

    if fungsiTerbang then
        fungsiTerbang:Disconnect()
        fungsiTerbang = nil
    end

    if HRP and HRP.Parent then
        HRP.CFrame = posAwalHRP
    end
    if mobilPart and mobilPart.Parent and posAwalMobil then
        mobilPart.CFrame = posAwalMobil
    end

    status.Text = "Status: OFF"
    status.TextColor3 = Color3.fromRGB(200, 80, 80)
    btnOff.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    btnOff.Text = "OFF ✔"

    print("[CDID] Script dimatikan")
end)

-- ============================================
-- [ INPUT KEYBOARD ]
-- ============================================
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.V then naik = true
    elseif input.KeyCode == Enum.KeyCode.Z then turun = true end
end)

UIS.InputEnded:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.V then naik = false
    elseif input.KeyCode == Enum.KeyCode.Z then turun = false end
end)

-- ============================================
-- [ LOOP TERBANG ]
-- ============================================
fungsiTerbang = RunService.RenderStepped:Connect(function(dt)
    if not aktif then return end
    if not HRP or not HRP.Parent then return end

    local arah = HRP.CFrame.LookVector
    local vertikal = 0

    if naik then vertikal = NAIK_SPEED
    elseif turun then vertikal = -TURUN_SPEED end

    HRP.CFrame = HRP.CFrame + Vector3.new(
        arah.X * KECEPATAN * dt,
        vertikal * dt,
        arah.Z * KECEPATAN * dt
    )

    if mobilPart and mobilPart.Parent then
        mobilPart.CFrame = HRP.CFrame * CFrame.new(
            OFFSET_X, OFFSET_Y, OFFSET_Z
        )
    end
end)

print("[CDID] Script aktif")
print("[CDID] V = Naik, Z = Turun")
