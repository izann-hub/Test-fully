local function SpawnAndSitOnBike()
    local h = LP.Character and LP.Character:FindFirstChild("Humanoid")
    if h and h.SeatPart then 
        print("✅ Already on bike!")
        FarmState.BikeSitting = true
        StartBikeLock(h.SeatPart)
        return true 
    end

    local bike = FindBike()
    
    if bike then
        print("✅ Bike sudah ada, langsung duduk...")
    else
        print("🎯 Teleport ke Dealer untuk spawn motor...")
        SafeTeleport(findClearSpot(Locations.Dealer, 8), "Dealer")
        task.wait(1)
        
        CloseAllDialogs()
        task.wait(0.3)
        
        local spawnFormats = {
            function() RPC:FireServer(BUY_DIRTBIKE, "Spawn", "DirtBike") end,
            function() RPC:FireServer("Spawn", "DirtBike", BUY_DIRTBIKE) end,
            function() RPC:FireServer(BUY_DIRTBIKE, "Spawn") end,
            function() RPC:FireServer("DirtBike", "Spawn") end,
            function() Reliable:FireServer(BUY_DIRTBIKE, "Spawn", "DirtBike") end,
        }
        
        for i, fmt in ipairs(spawnFormats) do
            print("🔄 Coba spawn format #" .. i)
            pcall(fmt)
            task.wait(1.5)
            bike = FindBike()
            if bike then
                print("✅ Motor muncul dengan format #" .. i)
                break
            end
        end
        
        if not bike then
            print("⚠️ RPC gagal, cari prompt spawn...")
            for _, v in pairs(Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and IsSpawnPrompt(v) then
                    local parent = v.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - Locations.Dealer).Magnitude
                        if dist < 50 then
                            print("🎯 Fire spawn prompt:", v.Name)
                            pcall(function()
                                v.MaxActivationDistance = 9999
                                v.RequiresLineOfSight = false
                                v.HoldDuration = 0
                                fireproximityprompt(v)
                            end)
                            task.wait(1.5)
                            bike = FindBike()
                            if bike then break end
                        end
                    end
                end
            end
        end
        
        if not bike then
            local startT = os.clock()
            while os.clock() - startT < 10 do
                bike = FindBike()
                if bike then break end
                task.wait(0.3)
            end
        end
    end

    if not bike then 
        print("❌ Bike tidak muncul setelah semua percobaan")
        CloseAllDialogs()
        return false 
    end
    
    print("✅ Bike found:", bike.Name)

    local ds = bike:FindFirstChild("DriveSeat") 
        or bike:FindFirstChildWhichIsA("Seat")
        or bike:FindFirstChild("Seat", true)
        or bike:FindFirstChildWhichIsA("VehicleSeat", true)
    if not ds then 
        print("❌ DriveSeat not found!")
        return false 
    end
    
    print("🪑 DriveSeat found:", ds.Name, ds.ClassName)

    CloseAllDialogs()
    task.wait(0.3)

    local vehicleParts = {}
    for _, part in pairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            vehicleParts[part] = part.Anchored
            part.Anchored = true
        end
    end
    task.wait(0.3)

    local c = LP.Character
    if c then
        local h2 = c:FindFirstChild("Humanoid")
        local r = c:FindFirstChild("HumanoidRootPart")
        if h2 and r then 
            r.CFrame = CFrame.new(67^2, 10^10, 67^2)
            h2.Health = 0 
        end
    end
    LP.CharacterAdded:Wait()
    local nr = LP.Character:WaitForChild("HumanoidRootPart")
    local nh = LP.Character:WaitForChild("Humanoid")

    task.wait(2)

    local tp = ds.CFrame * CFrame.new(0, 3, 0)
    print("🐢 Tween pelan ke motor...")
    local _, charParts = TweenToBike(tp.Position, nil)
    task.wait(0.3)

    local prom = ds:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prom and ds:FindFirstChild("Attachment") then 
        prom = ds.Attachment:FindFirstChildWhichIsA("ProximityPrompt") 
    end

    local maxRetry = 5
    for attempt = 1, maxRetry do
        print("🔄 Attempt sit #" .. attempt)
        
        local root = LP.Character:FindFirstChild("HumanoidRootPart")
        if root and ds then
            root.CFrame = ds.CFrame * CFrame.new(0, 0.5, 0)
            root.Velocity = Vector3.zero
        end
        task.wait(0.2)
        
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.Sit = true
                hum.Jump = false
            end)
        end
        task.wait(0.4)
        
        hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.SeatPart then
            print("✅ Berhasil duduk via humanoid.Sit!")
            
            if charParts then
                for part, data in pairs(charParts) do
                    if part and part.Parent then
                        part.Anchored = data.Anchored
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end
            
            task.wait(0.3)
            
            for part, origAnchor in pairs(vehicleParts) do
                if part and part.Parent then
                    part.Anchored = origAnchor
                end
            end
            
            FarmState.BikeSitting = true
            FarmState.BikeSpawned = true
            
            -- 🔒 START BIKE LOCK — anti turun dari motor
            StartBikeLock(ds)
            
            return true
        end
        
        if prom then
            prom.HoldDuration = 0
            prom.RequiresLineOfSight = false
            prom.MaxActivationDistance = 9e9
            pcall(function() fireproximityprompt(prom) end)
            task.wait(0.4)
            
            hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                print("✅ Berhasil duduk via prompt!")
                
                if charParts then
                    for part, data in pairs(charParts) do
                        if part and part.Parent then
                            part.Anchored = data.Anchored
                        end
                    end
                end
                
                for part, origAnchor in pairs(vehicleParts) do
                    if part and part.Parent then
                        part.Anchored = origAnchor
                    end
                end
                
                FarmState.BikeSitting = true
                FarmState.BikeSpawned = true
                
                StartBikeLock(ds)
                
                return true
            end
        end
    end

    if charParts then
        for part, data in pairs(charParts) do
            if part and part.Parent then
                part.Anchored = data.Anchored
            end
        end
    end
    for part, origAnchor in pairs(vehicleParts) do
        if part and part.Parent then
            part.Anchored = origAnchor
        end
    end

    print("❌ Gagal duduk setelah " .. maxRetry .. " percobaan")
    return false
end

