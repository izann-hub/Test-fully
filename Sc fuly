local function BuyAll(amount)
    amount = amount or FarmSettings.Amount
    FarmState.Step = "🛒 Buying Ingredients"
    for i = 1, amount do
        if StopRequest then return end
        local w, s, g = GetIngredientCount()
        if w < i then BuyWater() task.wait(0.45) end
        if s < i then BuySugar() task.wait(0.45) end
        if g < i then BuyGelatin() task.wait(0.45) end
    end
    local finalW, finalS, finalG = GetIngredientCount()
    if finalW >= amount and finalS >= amount and finalG >= amount then
        FarmState.TotalExpense = FarmState.TotalExpense + (amount * FarmSettings.IngredientCost)
        return true
    end
    return false
end

