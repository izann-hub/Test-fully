-- HIDE NAME
-- ============================================================
local HideName = {
    Enabled = false,
    RGB = false,
    CustomName = "GHOST.LOL",
    Color = Color3.fromRGB(255, 215, 0),
}

local RGBLoop = nil
local CurrentColor = HideName.Color

local function GenerateRGB()
    local colors = {
        Color3.fromRGB(255, 0, 0), Color3.fromRGB(0, 255, 0),
        Color3.fromRGB(0, 0, 255), Color3.fromRGB(255, 255, 0),
        Color3.fromRGB(255, 0, 255), Color3.fromRGB(0, 255, 255),
    }
    return colors[math.random(1, #colors)]
end

local function ApplyHideName()
    if not HideName.Enabled then return end
    
    pcall(function()
        local char = LP.Character
        if not char then return end
        
        local color = HideName.RGB and CurrentColor or HideName.Color
        
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("TextLabel") then
                local name = v.Name or ""
                if name:find("Name") or name:find("Label") or name:find("Tag") or name:find("Rank") then
                    v.Text = HideName.CustomName
                    v.TextColor3 = color
                end
            end
        end
    end)
end

local function StartRGBLoopName()
    if RGBLoop then return end
    HideName.RGB = true
    
    RGBLoop = task.spawn(function()
        while HideName.RGB and HideName.Enabled do
            CurrentColor = GenerateRGB()
            ApplyHideName()
            task.wait(0.15)
        end
        RGBLoop = nil
    end)
end

local function StopRGBLoopName()
    HideName.RGB = false
    if RGBLoop then
        pcall(function() task.cancel(RGBLoop) end)
        RGBLoop = nil
    end
end

local function ToggleHideName(enabled)
    HideName.Enabled = enabled
    
    if enabled then
        ApplyHideName()
    else
        StopRGBLoopName()
    end
end

