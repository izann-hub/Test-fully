        root.AssemblyLinearVelocity = Vector3.zero
    end)
    
    task.wait(0.2)
    
    pcall(function()
        hum.Health = 0
    end)
    
    local startT = os.clock()
    local respawned = false
    
    local conn
    conn = LP.CharacterAdded:Connect(function()
        respawned = true
    end)
    
    while os.clock() - startT < 5 do
        if respawned then break end
        local h = GetHumanoid()
        if h and h.Health > 0 and LP.Character then
            respawned = true
