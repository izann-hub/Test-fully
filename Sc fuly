local function Step12_BuyFakeIDAgain()
    print("[12] Buy Fake ID Again...")
    CurrentStep = "Buy Fake ID Again"
    
    TeleportTo(Locations.BuyFakeID)
    task.wait(1.5)
    
    local seller = nil
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "FakeIDSeller" and v:IsA("Model") then
            seller = v
            break
        end
    end
    
    if seller then
        local prompt = seller:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            FirePrompt(prompt)
            task.wait(2)
            
            local timeout = 0
            while timeout < 5 do
                for _, v in pairs(LP.Backpack:GetChildren()) do
                    if v:IsA("Tool") and (v.Name:find("Fake") or v.Name:find("ID")) then
                        return true
                    end
                end
                task.wait(0.5)
