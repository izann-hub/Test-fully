-- ===================== INSTA-INTERACT =====================
local function applyInsta()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if not modifiedPrompts[v] then
                modifiedPrompts[v] = v.HoldDuration
            end
            v.HoldDuration = 0
        end
    end
    holdConnection = PPS.PromptButtonHoldBegan:Connect(function(v)
        if not modifiedPrompts[v] then
            modifiedPrompts[v] = v.HoldDuration
        end
        v.HoldDuration = 0
    end)
end

local function removeInsta()
    if holdConnection then
        holdConnection:Disconnect()
        holdConnection = nil
    end
    for prompt, original in pairs(modifiedPrompts) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = original
        end
    end
    modifiedPrompts = {}
end

-- ===================== NO RECOIL =====================
local function enableRecoil(tool)
    if not tool:IsA("Tool") then return end
    local settingModule = tool:FindFirstChild("Setting")
    if not settingModule or not settingModule:IsA("ModuleScript") then return end
    local success, settings = pcall(require, settingModule)
    if not success or type(settings) ~= "table" then return end

    if not defaultSettings[tool.Name] then
        defaultSettings[tool.Name] = {
            Accuracy = settings.Accuracy,
            SpreadX = settings.SpreadX,
            SpreadY = settings.SpreadY,
            Range = settings.Range,
            Recoil = settings.Recoil
        }
    end

    settings.Accuracy = 1
    settings.SpreadX = 0
    settings.SpreadY = 0
    settings.Range = 50000
    settings.Recoil = 0
end

local function disableRecoil(tool)
    if not tool:IsA("Tool") then return end
    local settingModule = tool:FindFirstChild("Setting")
    if not settingModule or not settingModule:IsA("ModuleScript") then return end
    local success, settings = pcall(require, settingModule)
    if not success or type(settings) ~= "table" then return end
    if not defaultSettings[tool.Name] then return end

    local d = defaultSettings[tool.Name]
    settings.Accuracy = d.Accuracy
    settings.SpreadX = d.SpreadX
    settings.SpreadY = d.SpreadY
    settings.Range = d.Range
    settings.Recoil = d.Recoil
end

local function scanCharacter(character)
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            if recoilEnabled then
                enableRecoil(child)
            else
                disableRecoil(child)
            end
        end
    end
end

local function bindCharacter(character)
    for _, conn in ipairs(charConnections) do
        if conn then conn:Disconnect() end
    end
    charConnections = {}

    local childConn = character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            if recoilEnabled then
                enableRecoil(child)
            else
                disableRecoil(child)
            end
        end
    end)
    table.insert(charConnections, childConn)

    scanCharacter(character)
end

if LocalPlayer.Character then
    bindCharacter(LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(character)
    task.wait(0.5)
    bindCharacter(character)
    if recoilEnabled then
        scanCharacter(character)
    end
end)

