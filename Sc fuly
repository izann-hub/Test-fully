local function LockMotorPosition()
    if _MotorLockConn then return end
    local bike = _MotorState.bike
    if not bike or not bike.Parent then return end

    _MotorLockPartsOriginal = {}

    for _, part in ipairs(bike:GetDescendants()) do
        if part:IsA("BasePart") then
            _MotorLockPartsOriginal[part] = {
                Anchored   = part.Anchored,
                CanCollide = part.CanCollide,
            }
            pcall(function()
                part.Anchored = true
                part.AssemblyLinearVelocity  = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    _MotorLockConn = RunService.Heartbeat:Connect(function()
        local b = _MotorState.bike
        if not b or not b.Parent then return end

        if _MotorLockedRotation then
            pcall(function()
                local curPos = b:GetPivot().Position
                b:PivotTo(CFrame.new(curPos) * _MotorLockedRotation)
            end)
        end

        for _, part in ipairs(b:GetDescendants()) do
            if part:IsA("BasePart") then
                if not part.Anchored then
                    pcall(function() part.Anchored = true end)
                end
                pcall(function()
                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end

        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end)
end

local function UnlockMotorPosition()
    if _MotorLockConn then
        _MotorLockConn:Disconnect()
        _MotorLockConn = nil
    end
    for part, state in pairs(_MotorLockPartsOriginal) do
        if part and part.Parent then
            pcall(function()
                part.Anchored   = state.Anchored
                part.CanCollide = state.CanCollide
            end)
        end
    end
    _MotorLockPartsOriginal = {}
end

local function ResetMotorLockedRotation()
    _MotorLockedRotation = nil
end

local function RecaptureMotorRotation()
    local bike = _MotorState and _MotorState.bike
    if not bike or not bike.Parent then return false end
    local ok, pv = pcall(function() return bike:GetPivot() end)
    if not ok or not pv then return false end
    _MotorLockedRotation = pv.Rotation
    pcall(function()
        bike:PivotTo(CFrame.new(pv.Position) * _MotorLockedRotation)
    end)
    return true
