local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = Workspace.CurrentCamera

local THEME = {
    BgPanel     = Color3.fromRGB(10, 15, 30),    
    BgRow       = Color3.fromRGB(20, 30, 55),    
    BgSlider    = Color3.fromRGB(45, 60, 95),    
    Accent      = Color3.fromRGB(60, 130, 220),  
    AccentDark  = Color3.fromRGB(30, 70, 140),   
    TextPrimary = Color3.fromRGB(255, 255, 255), 
    TextAccent  = Color3.fromRGB(120, 180, 255), 
}

local CONFIG = {
    CrosshairSize = 32, 
    MinSize = 16,
    MaxSize = 128,
    FOV = 90,
    Visible = true,
}

local screenGui
local function createGui()
    if screenGui and screenGui.Parent then return end
    
    screenGui = Instance.new("ScreenGui")
    screenGui.Name = "NRD_ONTOP"
    screenGui.ResetOnSpawn = false
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999999
    screenGui.Parent = playerGui

    -- CROSSHAIR STATIS DI TENGAH LAYAR
    local crosshair = Instance.new("Frame")
    crosshair.Name = "Crosshair"
    crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
    crosshair.Position = UDim2.new(0.5, 0, 0.5, 0)
    crosshair.Size = UDim2.new(0, CONFIG.CrosshairSize, 0, CONFIG.CrosshairSize)
    crosshair.BackgroundTransparency = 1
    crosshair.Parent = screenGui

    local plus = Instance.new("TextLabel")
    plus.Name = "PlusText"
    plus.BackgroundTransparency = 1
    plus.Size = UDim2.new(1, 0, 1, 0)
    plus.Text = "+"
    plus.TextColor3 = Color3.fromRGB(255, 255, 255)
    plus.TextScaled = true
    plus.Font = Enum.Font.GothamBold
    plus.Parent = crosshair

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 3, 0, 3)
    dot.Position = UDim2.new(0.5, 0, 0.5, 0)
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    dot.BorderSizePixel = 0
    dot.Parent = crosshair
    
    local dotCorner = Instance.new("UICorner")
    dotCorner.CornerRadius = UDim.new(1, 0)
    dotCorner.Parent = dot

    -- UI PANEL
    local uiFrame = Instance.new("Frame")
    uiFrame.Name = "SettingsPanel"
    uiFrame.Size = UDim2.new(0, 260, 0, 210)
    uiFrame.Position = UDim2.new(1, -280, 0, 20)
    uiFrame.BackgroundColor3 = THEME.BgPanel
    uiFrame.BackgroundTransparency = 0.1
    uiFrame.BorderSizePixel = 0
    uiFrame.ZIndex = 10
    uiFrame.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 10)
    uiCorner.Parent = uiFrame

    local uiStroke = Instance.new("UIStroke")
    uiStroke.Color = THEME.Accent
    uiStroke.Thickness = 1.5
    uiStroke.Transparency = 0.3
    uiStroke.Parent = uiFrame

    local uiPadding = Instance.new("UIPadding")
    uiPadding.PaddingTop = UDim.new(0, 10)
    uiPadding.PaddingBottom = UDim.new(0, 10)
    uiPadding.PaddingLeft = UDim.new(0, 10)
    uiPadding.PaddingRight = UDim.new(0, 10)
    uiPadding.Parent = uiFrame

    local uiLayout = Instance.new("UIListLayout")
    uiLayout.SortOrder = Enum.SortOrder.LayoutOrder
    uiLayout.Padding = UDim.new(0, 6)
    uiLayout.Parent = uiFrame

    local titleFrame = Instance.new("Frame")
    titleFrame.Size = UDim2.new(1, 0, 0, 30)
    titleFrame.BackgroundColor3 = THEME.AccentDark
    titleFrame.BackgroundTransparency = 0.15
    titleFrame.BorderSizePixel = 0
    titleFrame.LayoutOrder = 0
    titleFrame.ZIndex = 11
    titleFrame.Parent = uiFrame

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(0, 6)
    tCorner.Parent = titleFrame

    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, 0, 1, 0)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = "NRD ONTOP"
    titleLabel.TextColor3 = THEME.TextPrimary
    titleLabel.TextSize = 16
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.ZIndex = 12
    titleLabel.Parent = titleFrame

    local function buatBaris(nama, urutan)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, 38)
        row.BackgroundColor3 = THEME.BgRow
        row.BorderSizePixel = 0
        row.LayoutOrder = urutan
        row.ZIndex = 11
        row.Parent = uiFrame
        
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = row
        
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.5, 0, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = nama
        lbl.TextColor3 = THEME.TextPrimary
        lbl.TextSize = 15
        lbl.Font = Enum.Font.GothamBold
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.ZIndex = 12
        lbl.Parent = row
        
        return row
    end

    local rowToggle = buatBaris("Status", 1)
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 80, 0, 26)
    toggleBtn.Position = UDim2.new(1, -90, 0.5, 0)
    toggleBtn.AnchorPoint = Vector2.new(0, 0.5)
    toggleBtn.BackgroundColor3 = THEME.Accent
    toggleBtn.TextColor3 = THEME.TextPrimary
    toggleBtn.TextSize = 13
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.Text = "AKTIF"
    toggleBtn.ZIndex = 12
    toggleBtn.Parent = rowToggle

    local togCorner = Instance.new("UICorner")
    togCorner.CornerRadius = UDim.new(0, 6)
    togCorner.Parent = toggleBtn

    local rowFov = buatBaris("FOV", 2)
    local fovValue = Instance.new("TextLabel")
    fovValue.Size = UDim2.new(0, 100, 1, 0)
    fovValue.Position = UDim2.new(1, -110, 0, 0)
    fovValue.BackgroundTransparency = 1
    fovValue.Text = tostring(CONFIG.FOV)
    fovValue.TextColor3 = THEME.TextAccent
    fovValue.TextSize = 15
    fovValue.Font = Enum.Font.GothamBold
    fovValue.TextXAlignment = Enum.TextXAlignment.Right
    fovValue.ZIndex = 12
    fovValue.Parent = rowFov

    local rowSize = buatBaris("CrosshairSize", 3)
    local sizeValue = Instance.new("TextLabel")
    sizeValue.Name = "SizeValue"
    sizeValue.Size = UDim2.new(0, 60, 0, 12)
    sizeValue.Position = UDim2.new(1, -110, 0, 2)
    sizeValue.BackgroundTransparency = 1
    sizeValue.Text = CONFIG.CrosshairSize .. "/" .. CONFIG.MaxSize
    sizeValue.TextColor3 = THEME.TextAccent
    sizeValue.TextSize = 11
    sizeValue.Font = Enum.Font.GothamBold
    sizeValue.TextXAlignment = Enum.TextXAlignment.Right
    sizeValue.ZIndex = 12
    sizeValue.Parent = rowSize

    local slider = Instance.new("Frame")
    slider.Name = "Slider"
    slider.Size = UDim2.new(0, 100, 0, 8)
    slider.Position = UDim2.new(1, -110, 0.7, 0)
    slider.BackgroundColor3 = THEME.BgSlider
    slider.BorderSizePixel = 0
    slider.ZIndex = 12
    slider.Parent = rowSize

    local sCorner = Instance.new("UICorner")
    sCorner.CornerRadius = UDim.new(1, 0)
    sCorner.Parent = slider

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = UDim2.new((CONFIG.CrosshairSize - CONFIG.MinSize)/(CONFIG.MaxSize - CONFIG.MinSize), 0, 1, 0)
    fill.BackgroundColor3 = THEME.Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 13
    fill.Parent = slider

    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(1, 0)
    fCorner.Parent = fill

    local knob = Instance.new("Frame")
    knob.Name = "Knob"
    knob.Size = UDim2.new(0, 16, 0, 16)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new((CONFIG.CrosshairSize - CONFIG.MinSize)/(CONFIG.MaxSize - CONFIG.MinSize), 0, 0.5, 0)
    knob.BackgroundColor3 = THEME.TextPrimary
    knob.BorderSizePixel = 0
    knob.ZIndex = 14
    knob.Parent = slider

    local kCorner = Instance.new("UICorner")
    kCorner.CornerRadius = UDim.new(1, 0)
    kCorner.Parent = knob

    -- LOGIKA UI
    toggleBtn.MouseButton1Click:Connect(function()
        CONFIG.Visible = not CONFIG.Visible
        crosshair.Visible = CONFIG.Visible
        toggleBtn.Text = CONFIG.Visible and "AKTIF" or "MATI"
        toggleBtn.BackgroundColor3 = CONFIG.Visible and THEME.Accent or THEME.BgSlider
    end)

    local dragging = false
    local function getAlphaFromX(x)
        return math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
    end

    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            local alpha = getAlphaFromX(input.Position.X)
            local newSize = CONFIG.MinSize + alpha * (CONFIG.MaxSize - CONFIG.MinSize)
            crosshair.Size = UDim2.new(0, newSize, 0, newSize)
            sizeValue.Text = math.floor(newSize) .. "/" .. CONFIG.MaxSize
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local alpha = getAlphaFromX(input.Position.X)
            local newSize = CONFIG.MinSize + alpha * (CONFIG.MaxSize - CONFIG.MinSize)
            crosshair.Size = UDim2.new(0, newSize, 0, newSize)
            sizeValue.Text = math.floor(newSize) .. "/" .. CONFIG.MaxSize
            fill.Size = UDim2.new(alpha, 0, 1, 0)
            knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
end

createGui()

-- SISTEM AUTO-REPAIR (Mencegah UI hilang saat mati/respawn)
RunService.RenderStepped:Connect(function()
    if not screenGui or not screenGui.Parent then
        createGui()
    end
end)
