--============================================================
-- FUNGSI UPDATE
--============================================================
local function updateSize(size)
    size = math.clamp(size, CONFIG.MinSize, CONFIG.MaxSize)
    CONFIG.CrosshairSize = size
    
    -- Update ukuran ImageLabel secara proporsional (kotak)
    crosshair.Size = UDim2.new(0, size, 0, size)
    
    -- Update UI Slider
    sizeValue.Text = math.floor(size) .. "/" .. CONFIG.MaxSize
    local alpha = (size - CONFIG.MinSize) / (CONFIG.MaxSize - CONFIG.MinSize)
    fill.Size = UDim2.new(alpha, 0, 1, 0)
    knob.Position = UDim2.new(alpha, 0, 0.5, 0)
end

local function updateFOV(value)
    value = math.clamp(tonumber(value) or 90, 1, 120)
    CONFIG.FOV = value
    camera.FieldOfView = value
    fovValue.Text = tostring(math.floor(value))
end

--============================================================
-- INPUT HANDLERS
--============================================================
-- Toggle Button (Tampil / Sembunyi)
toggleBtn.MouseButton1Click:Connect(function()
    CONFIG.Visible = not CONFIG.Visible
    crosshair.Visible = CONFIG.Visible
    if CONFIG.Visible then
        toggleBtn.Text = "AKTIF"
        toggleBtn.BackgroundColor3 = THEME.Accent
    else
        toggleBtn.Text = "MATI"
        toggleBtn.BackgroundColor3 = THEME.BgSlider
    end
end)

-- Drag Slider
local dragging = false

local function getAlphaFromX(x)
    local absPos = slider.AbsolutePosition.X
    local absSize = slider.AbsoluteSize.X
    return math.clamp((x - absPos) / absSize, 0, 1)
end

knob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
    end
end)

slider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        local alpha = getAlphaFromX(input.Position.X)
        updateSize(CONFIG.MinSize + alpha * (CONFIG.MaxSize - CONFIG.MinSize))
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement 
    or input.UserInputType == Enum.UserInputType.Touch) then
        local alpha = getAlphaFromX(input.Position.X)
        updateSize(CONFIG.MinSize + alpha * (CONFIG.MaxSize - CONFIG.MinSize))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

--============================================================
-- INISIALISASI
--============================================================
updateSize(CONFIG.CrosshairSize)
updateFOV(CONFIG.FOV)

print("[NRD ONTOP] Loaded - Image Crosshair Mode")
