        local result, bit = 0, 1
        while a > 0 or b > 0 do
            if (a % 2) ~= (b % 2) then result = result + bit end
            a, b, bit = math.floor(a / 2), math.floor(b / 2), bit * 2
        end
        return result
    end
end

