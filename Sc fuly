-- ============================================================
-- TWEEN TELEPORT VEHICLE
-- ============================================================
local isTeleporting = false

local function TweenTeleportVehicle(targetPos)
    if isTeleporting then return false end
    isTeleporting = true
    
    local success = pcall(function()
        local vehicle = GetVehicle()
        if not vehicle then return end
        
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        
        local primaryPart = vehicle:FindFirstChild("DriveSeat") 
            or vehicle.PrimaryPart 
            or vehicle:FindFirstChildWhichIsA("BasePart")
        if not primaryPart then return end
        
        local vehicleStartCF = primaryPart.CFrame
        local vehicleRotation = vehicleStartCF - vehicleStartCF.Position
        local startPos = vehicleStartCF.Position
        
        local finalVector = Vector3.new(targetPos.X, targetPos.Y + 3, targetPos.Z)
        local flyY = startPos.Y + FLY_DEPTH
        local flyStartVector = Vector3.new(startPos.X, flyY, startPos.Z)
        local flyEndVector = Vector3.new(finalVector.X, flyY, finalVector.Z)
        
        local style = Enum.EasingStyle.Linear
        local dir = Enum.EasingDirection.Out
        
        local vehicleParts = {}
        for _, part in pairs(vehicle:GetDescendants()) do
            if part:IsA("BasePart") then
                vehicleParts[part] = {
                    Anchored = part.Anchored,
                    Offset = vehicleStartCF:ToObjectSpace(part.CFrame)
                }
                part.Anchored = true
            end
        end
        
        local charStartCF = hrp.CFrame
        local charOffset = vehicleStartCF:ToObjectSpace(charStartCF)
        
        local charParts = {}
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                charParts[part] = {
                    Anchored = part.Anchored,
                    Offset = charStartCF:ToObjectSpace(part.CFrame)
                }
                part.Anchored = true
            end
        end
        
        local distDown = math.abs(flyY - startPos.Y)
        local durationDown = math.clamp(distDown / TWEEN_SPEED, 0.1, 2)
        local targetDownCF = CFrame.new(flyStartVector) * vehicleRotation
        
        local tweensDown = {}
        for part, data in pairs(vehicleParts) do
            if part and part.Parent then
                local t = TweenService:Create(part, TweenInfo.new(durationDown, style, dir), { CFrame = targetDownCF * data.Offset })
                table.insert(tweensDown, t)
            end
        end
        for part, data in pairs(charParts) do
            if part and part.Parent then
                local targetCharCF = targetDownCF * charOffset
                local t = TweenService:Create(part, TweenInfo.new(durationDown, style, dir), { CFrame = targetCharCF * data.Offset })
                table.insert(tweensDown, t)
            end
        end
        for _, t in ipairs(tweensDown) do t:Play() end
        if tweensDown[1] then tweensDown[1].Completed:Wait() end
        
        local distHoriz = (flyEndVector - flyStartVector).Magnitude
        local durationHoriz = math.clamp(distHoriz / TWEEN_SPEED, 0.15, 5)
        local targetHorizCF = CFrame.new(flyEndVector) * vehicleRotation
        
        local tweensHoriz = {}
        for part, data in pairs(vehicleParts) do
            if part and part.Parent then
                local t = TweenService:Create(part, TweenInfo.new(durationHoriz, style, dir), { CFrame = targetHorizCF * data.Offset })
                table.insert(tweensHoriz, t)
            end
        end
        for part, data in pairs(charParts) do
            if part and part.Parent then
                local targetCharCF = targetHorizCF * charOffset
                local t = TweenService:Create(part, TweenInfo.new(durationHoriz, style, dir), { CFrame = targetCharCF * data.Offset })
                table.insert(tweensHoriz, t)
            end
        end
        for _, t in ipairs(tweensHoriz) do t:Play() end
        if tweensHoriz[1] then tweensHoriz[1].Completed:Wait() end
        
        local distUp = math.abs(finalVector.Y - flyY)
        local durationUp = math.clamp(distUp / TWEEN_SPEED, 0.1, 2)
        local targetFinalCF = CFrame.new(finalVector) * vehicleRotation
        
        local tweensUp = {}
        for part, data in pairs(vehicleParts) do
            if part and part.Parent then
                local t = TweenService:Create(part, TweenInfo.new(durationUp, style, dir), { CFrame = targetFinalCF * data.Offset })
                table.insert(tweensUp, t)
            end
        end
        for part, data in pairs(charParts) do
            if part and part.Parent then
                local targetCharCF = targetFinalCF * charOffset
                local t = TweenService:Create(part, TweenInfo.new(durationUp, style, dir), { CFrame = targetCharCF * data.Offset })
                table.insert(tweensUp, t)
            end
        end
        for _, t in ipairs(tweensUp) do t:Play() end
        if tweensUp[1] then tweensUp[1].Completed:Wait() end
        
        for part, data in pairs(vehicleParts) do
            if part and part.Parent then
                part.Anchored = data.Anchored
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        for part, data in pairs(charParts) do
            if part and part.Parent then
                part.Anchored = data.Anchored
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
    
    isTeleporting = false
    return success
end

