local function CookMarshmallow(amount, skipBuy)
    amount = amount or FarmSettings.Amount
    FarmState.BatchProgress = "0/" .. amount
    FarmState.CurrentBatch = 0

    if not skipBuy then
        local char = Player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local isNearStore = false
        if hrp and (hrp.Position - Vector3.new(510, 4, 602)).Magnitude < 20 then isNearStore = true end
        if not isNearStore then
            FarmState.Step = "🚗 Going to Store"
            doSuicideTP({ x = 510, y = 4, z = 602 })
            task.wait(1)
        end
        FarmState.Step = "🛒 Buying Ingredients"
        local buySuccess = false
        for retry = 1, 5 do
            buySuccess = BuyAll(amount)
            if buySuccess then break end
            task.wait(2)
        end
        if not buySuccess then
            task.wait(3)
            return true
        end
        task.wait(0.5)
    end

    FarmState.Step = "🚗 Going to Apartment"
    local targetPos, entry = GetOwnedAprtTarget()
    if not targetPos then return true end
    af_TP(CFrame.new(targetPos.X, targetPos.Y + 3, targetPos.Z))
    task.wait(1)

    local House = entry and entry.obj
    if not House then return true end

    EnableNembusTembok()
    task.wait(0.2)

    local Interior = House:FindFirstChild("Interior") or House
    local Pot = Interior:FindFirstChild("Cooking Pot", true)
    local PotPrompt = nil
    if Pot then
        local att = Pot:FindFirstChild("Attachment")
        PotPrompt = att and att:FindFirstChildOfClass("ProximityPrompt") or Pot:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if not Pot or not PotPrompt then return true end

    QuickTeleportToPot(Pot)
    task.wait(0.5)

    for i = 1, amount do
        if StopRequest then return false end
        FarmState.CurrentBatch = i
        FarmState.BatchProgress = i .. "/" .. amount

        FarmState.Step = "💧 Water (" .. i .. "/" .. amount .. ")"
        if af_Equip("Water") then
            task.wait(0.2)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end
        local timeout = 0
        while timeout < 21 do
            if StopRequest then return false end
            local timer = Pot:FindFirstChild("Timer")
            if timer and timer:IsA("TextLabel") and timer.Text == "0" then break end
            task.wait(0.5)
            timeout = timeout + 0.5
        end

        FarmState.Step = "🧂 Sugar (" .. i .. "/" .. amount .. ")"
        if af_Equip("Sugar Block Bag") then
            task.wait(0.2)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end
        timeout = 0
        while timeout < 2 do
            if StopRequest then return false end
            local timer = Pot:FindFirstChild("Timer")
            if timer and timer:IsA("TextLabel") and timer.Text == "0" then break end
            task.wait(0.5)
            timeout = timeout + 0.5
        end

        FarmState.Step = "🧪 Gelatin (" .. i .. "/" .. amount .. ")"
        if af_Equip("Gelatin") then
            task.wait(0.2)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end
        timeout = 0
        while timeout < 46 do
            if StopRequest then return false end
            local timer = Pot:FindFirstChild("Timer")
            if timer and timer:IsA("TextLabel") and timer.Text == "0" then break end
            task.wait(0.5)
            timeout = timeout + 0.5
        end

        FarmState.Step = "🛍️ Collect (" .. i .. "/" .. amount .. ")"
        if af_Equip("Empty Bag") then
            task.wait(0.2)
            af_FirePrompt(PotPrompt)
            task.wait(0.5)
            af_Unequip()
        end

        FarmState.MarshmallowsMade = FarmState.MarshmallowsMade + 1
        UpdateCashTracker()
    end

    DisableNembusTembok()
    DisableFlyLock()
    return true
end

