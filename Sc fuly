local function GetIngredientCount()
    local w, s, g = 0, 0, 0
    if Player.Backpack then
        for _, v in pairs(Player.Backpack:GetChildren()) do
            if v.Name == "Water" then w = w + 1 end
            if v.Name == "Sugar Block Bag" then s = s + 1 end
            if v.Name == "Gelatin" then g = g + 1 end
        end
    end
    return w, s, g
end

local function FireBuy(typeStr)
    pcall(function()
        if not RemoteEvent then return end
        if buffer and buffer.fromstring then
            RemoteEvent:FireServer(buffer.fromstring(typeStr))
        else
            RemoteEvent:FireServer(typeStr)
        end
    end)
end

local function BuyAll(amount)
    amount = amount or FarmSettings.Amount
    FarmState.Step = "Buying Ingredients"
    for i = 1, amount do
        if StopRequest then return end
        local w, s, g = GetIngredientCount()
        if w < i then FireBuy("\024\019\003") task.wait(0.45) end
        if s < i then FireBuy("\024\019\002") task.wait(0.45) end
        if g < i then FireBuy("\024\019\001") task.wait(0.45) end
    end
    local fw, fs, fg = GetIngredientCount()
    if fw >= amount and fs >= amount and fg >= amount then return true end
    return false
end

