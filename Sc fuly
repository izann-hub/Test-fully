                        end
                        return o(a, b)
                    end)
                end)
            end
        end

        pcall(function()
            for _, Object in pairs(getgc(true)) do
                if typeof(Object) == "table" and typeof(rawget(Object, "Homeless")) == "table" then
                    if rawget(Object.Homeless, "MaxDistance") then
                        Object.Homeless.MaxDistance = 9e9
                    end
                end
            end
        end)
    end)

