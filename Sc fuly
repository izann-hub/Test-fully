-- ============================================================
-- DECORATE (2 LEVEL, RINGAN)
-- ============================================================
local rgbStrokes   = {}
local whiteStrokes = {}

local function ApplyBackgroundBlack(instance)
    pcall(function() instance.BackgroundColor3 = BLACK end)
end

local function ApplyWhiteStroke(instance, thickness)
    pcall(function()
        local stroke = Instance.new("UIStroke")
        stroke.Color = WHITE
        stroke.Thickness = thickness or 1
        stroke.Transparency = 0
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = instance
        table.insert(whiteStrokes, stroke)
    end)
end

local function ApplyRGBStroke(instance, thickness)
    pcall(function()
        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(255, 0, 0)
        stroke.Thickness = thickness or 1
        stroke.Transparency = 0
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = instance
        table.insert(rgbStrokes, stroke)
    end)
end

local function Decorate(instance, whiteThickness, rgbThickness)
    if not instance then return end
    ApplyBackgroundBlack(instance)
    ApplyWhiteStroke(instance, whiteThickness)
    ApplyRGBStroke(instance, rgbThickness)
end

task.wait(0.5) -- beri waktu Rayfield render

pcall(function()
    local mainFrame = Window.Frame or Window.Main or Window.Root
    if mainFrame then Decorate(mainFrame, 2, 1) end
end)

for _, tab in ipairs({Tab1, Tab2}) do
    pcall(function()
        if tab and tab.Frame then Decorate(tab.Frame, 2, 1) end
    end)
    -- Hanya 2 level: Frame → children → grandchildren
    pcall(function()
        if tab and tab.Frame then
            for _, child in ipairs(tab.Frame:GetChildren()) do
                if child:IsA("Frame") then
                    Decorate(child, 1, 1)
                    for _, grandchild in ipairs(child:GetChildren()) do
                        if grandchild:IsA("Frame") then
                            Decorate(grandchild, 1, 1)
                        elseif grandchild:IsA("TextButton") then
                            ApplyBackgroundBlack(grandchild)
                            ApplyRGBStroke(grandchild, 1)
                        end
                    end
                elseif child:IsA("TextButton") then
                    ApplyBackgroundBlack(child)
                    ApplyRGBStroke(child, 1)
                end
            end
        end
    end)
end

-- ============================================================
-- SATU LOOP: FOV + RGB (RGB tiap 3 frame)
-- ============================================================
local hue = 0
local frameCount = 0

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1

    -- FOV circle
    if _G.ShowFOV then
        FOVCircle.Position  = UserInputService:GetMouseLocation()
        FOVCircle.Radius    = _G.FOVRadius
        FOVCircle.Thickness = _G.FOVThickness
        FOVCircle.Color     = _G.FOVColor
        FOVCircle.Visible   = true
    else
        FOVCircle.Visible = false
    end

    -- RGB tiap 3 frame
    if frameCount % 3 == 0 and #rgbStrokes > 0 then
        hue = (hue + RGB_SPEED * 3) % 1
        local color = Color3.fromHSV(hue, RGB_SATURATION, RGB_VALUE)
        for i = #rgbStrokes, 1, -1 do
            local stroke = rgbStrokes[i]
            if stroke and stroke.Parent then
                stroke.Color = color
            else
                table.remove(rgbStrokes, i)
            end
        end
    end
end)

