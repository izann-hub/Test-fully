if not filtergc then
    filtergc = function(ftype, filters, returnSingle)
        local results = {}
        local ok, gc = pcall(getgc, true)
        if not ok then return returnSingle and nil or results end
        for _, obj in pairs(gc) do
            if type(obj) == "function" then
                local ok2, info = pcall(debug.getinfo, obj)
                if ok2 and info then
                    local match = true
                    if filters.StartLine and info.linedefined ~= filters.StartLine then match = false end
                    if filters.Source and info.source ~= filters.Source then match = false end
                    if match then
                        if returnSingle then return obj end
                        table.insert(results, obj)
                    end
                end
            end
        end
        return returnSingle and nil or results
    end
end

if not bit32 then bit32 = {} end
if not bit32.bxor then
    bit32.bxor = function(a, b)
        local result, bit = 0, 1
        while a > 0 or b > 0 do
            if (a % 2) ~= (b % 2) then result = result + bit end
            a, b, bit = math.floor(a / 2), math.floor(b / 2), bit * 2
        end
        return result
    end
end

local function tryFind(ln)
    local fn = filtergc("function", { StartLine = ln }, true)
    if type(fn) ~= "function" then
        local all = filtergc("function", { StartLine = ln })
        if type(all) == "table" and #all > 0 then fn = all[1] end
    end
    return fn
end

local Hyphon = { Encode = nil, Decode = nil, Script = nil, Ready = false }
local function InitHyphon()
    local fn2102 = tryFind(2102)
    local fn2247 = tryFind(2247)
    local fn2846 = tryFind(2846)
    local fnFake = tryFind(1097)
    if not (fn2102 and fn2247 and fn2846 and fnFake) then return false end

    Hyphon.Encode = debug.getupvalue(fn2102, 1)
    Hyphon.Decode = debug.getupvalue(fn2102, 21)

    pcall(function()
        local ok, nilinst = pcall(getnilinstances)
        if ok and nilinst then
            for _, o in pairs(nilinst) do
                if o:IsA("Script") and o.Name:len() == 32 then
                    Hyphon.Script = o
                    break
                end
            end
        end
    end)

    pcall(function()
        local RF = debug.getupvalue(fn2247, 6)
        if RF and RF.InvokeServer then
            local old = hookfunction(RF.InvokeServer, function(self, ...)
                local args = table.pack(...)
                if type(args[1]) == "table" and args[1][1] then
                    getgenv().DA_T1 = args[1][1]
                    getgenv().DA_T2 = args[1][2]
                    getgenv().DA_T3 = args[1][6]
                    getgenv().DA_T4 = args[1][11]
                end
                return old(self, ...)
            end)
        end
    end)

    if bit32 and bit32.bxor and checkcaller and getcallingscript and Hyphon.Script then
        pcall(function()
            local oldBxor = hookfunction(bit32.bxor, function(a, b)
                if not checkcaller() and getcallingscript() == Hyphon.Script then
                    return task.wait(9e9)
                end
                return oldBxor(a, b)
            end)
        end)
    end

    Hyphon.Ready = true
    return true
end

local KICK_KEYWORDS = {
    "Kick", "Ban", "Disconnect", "Error", "Moderation",
    "Warning", "Alert", "Popup", "Notice", "Detection",
    "Anti", "Handshake",
}
local function isKickGui(name)
    if not name then return false end
    for _, kw in ipairs(KICK_KEYWORDS) do
        if name:find(kw) then return true end
    end
    return false
end

function Bypass.StartKickDestroyer()
    if Bypass._kickThread then return end
    Bypass._kickRunning = true
    Bypass._kickThread = task.spawn(function()
        local Players = game:GetService("Players")
        local CoreGui = game:GetService("CoreGui")
        while Bypass._kickRunning do
            pcall(function()
                for _, gui in pairs(CoreGui:GetChildren()) do
                    if isKickGui(gui.Name) then gui:Destroy() end
                end
                local lp = Players.LocalPlayer
                local pg = lp and lp:FindFirstChild("PlayerGui")
                if pg then
                    for _, gui in pairs(pg:GetChildren()) do
                        if isKickGui(gui.Name) then gui:Destroy() end
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end

function Bypass.AntiKick()
    pcall(function()
        local Players = game:GetService("Players")
        if Players.LocalPlayer then
            Players.LocalPlayer.Kick = function() return end
        end
        Players.Kick = function() return end
    end)
end

function Bypass.StartAntiAFK()
    if Bypass._afkConn then return end
    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer
    if not lp then return end
    Bypass._afkConn = lp.Idled:Connect(function()
        pcall(function()
            local VU = game:GetService("VirtualUser")
            VU:CaptureController()
            VU:ClickButton2(Vector2.new())
        end)
    end)
end

Bypass.AutoRejoin = {
    Enabled = true,
    ScriptUrl = "",
    GameId = game.PlaceId,
}
local _isDeathTP = false
function Bypass.MarkDeathTeleport() _isDeathTP = true end

function Bypass.DoRejoin()
    if not Bypass.AutoRejoin.Enabled then return end
    if _isDeathTP then _isDeathTP = false; return end
    pcall(function()
        game:GetService("TeleportService"):Teleport(Bypass.AutoRejoin.GameId)
    end)
end

function Bypass.StartRejoinDetector()
    if Bypass._rejoinConn then return end
    local LogService = game:GetService("LogService")
    Bypass._rejoinConn = LogService.MessageOut:Connect(function(msg, mtype)
        if mtype ~= Enum.MessageType.MessageError then return end
        if msg:find("Kicked") or msg:find("Disconnected") or msg:find("Idle")
           or msg:find("Removed") or msg:find("Connection lost") or msg:find("Ban") then
            task.spawn(Bypass.DoRejoin)
        end
    end)
end

function Bypass.Start()
    Bypass.AntiKick()
    Bypass.StartKickDestroyer()
    Bypass.StartAntiAFK()
    Bypass.StartRejoinDetector()
    local hyphonOk = InitHyphon()
    if hyphonOk then
        print("[Dark Angel] Hyphon Bypass: OK")
    else
        print("[Dark Angel] Hyphon Bypass: SKIP (fungsi tidak ditemukan)")
    end
    print("[Dark Angel] Bypass Active.")
    return hyphonOk
end

