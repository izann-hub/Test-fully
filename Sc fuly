-- ============================================================
-- 🎯 IS SPAWN PROMPT
-- ============================================================
local function IsSpawnPrompt(prompt)
    if not prompt then return false end
    local pName = tostring(prompt.Name or ""):lower()
    local parent = prompt.Parent
    local parentName = parent and tostring(parent.Name or ""):lower() or ""
    local grandName = parent and parent.Parent and tostring(parent.Parent.Name or ""):lower() or ""
    
    if pName:find("sell") or pName:find("jual") then return false end
    if parentName:find("car") and not parentName:find("bike") then return false end
    if grandName:find("dealer") and not grandName:find("bike") and not grandName:find("vehicle") then return false end
    
    if pName:find("spawn") or pName:find("buy") or pName:find("beli") then return true end
    if pName:find("bike") or pName:find("motor") or pName:find("vehicle") then return true end
    if parentName:find("spawn") or parentName:find("bike") or parentName:find("vehicle") then return true end
    
    return false
end

