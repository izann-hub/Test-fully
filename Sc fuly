local function applyCrosshairSize(size)
    crosshairState.size = size
    local armLen = math.max(2, size * 0.5)
    local thickness = 2
    local gap = math.max(1, size * 0.25)
    top.Size = UDim2.new(0, thickness, 0, armLen)
    top.Position = UDim2.new(0.5, 0, 0.5, -gap)
    bottom.Size = UDim2.new(0, thickness, 0, armLen)
    bottom.Position = UDim2.new(0.5, 0, 0.5, gap)
    left.Size = UDim2.new(0, armLen, 0, thickness)
    left.Position = UDim2.new(0.5, -gap, 0.5, 0)
    right.Size = UDim2.new(0, armLen, 0, thickness)
    right.Position = UDim2.new(0.5, gap, 0.5, 0)
    print("[JENOWA] Crosshair size = "..tostring(size))
end

AddToggle("Crosshair Custom", false, function(s)
    crosshairState.enabled = s
    customCross.Visible = s
    if s then applyCrosshairSize(crosshairState.size) end
end)

AddToggle("Crosshair Gede", false, function(s)
    if s then applyCrosshairSize(40) else applyCrosshairSize(12) end
end)

AddToggle("Crosshair Jumbo", false, function(s)
