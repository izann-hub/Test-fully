-- ===================== INSTA-INTERACT =====================
local function applyInsta()
    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            if not modifiedPrompts[v] then
                modifiedPrompts[v] = v.HoldDuration
            end
            v.HoldDuration = 0
        end
    end
    holdConnection = PPS.PromptButtonHoldBegan:Connect(function(v)
        if not modifiedPrompts[v] then
            modifiedPrompts[v] = v.HoldDuration
        end
        v.HoldDuration = 0
    end)
end

local function removeInsta()
    if holdConnection then
        holdConnection:Disconnect()
        holdConnection = nil
    end
    for prompt, original in pairs(modifiedPrompts) do
        if prompt and prompt.Parent then
            prompt.HoldDuration = original
        end
    end
    modifiedPrompts = {}
end

-- ===================== ESP =====================
local Camera = Workspace.CurrentCamera

local function createESP(player)
    if player == LocalPlayer then return end
    if espCache[player] then return end

    local box = Drawing.new("Square")
    box.Thickness = 1
    box.Color = Color3.fromRGB(255, 255, 255)
    box.Filled = false
    box.Transparency = 1
    box.Visible = false

    local name = Drawing.new("Text")
    name.Size = 14
    name.Center = true
    name.Outline = true
    name.OutlineColor = Color3.fromRGB(0, 0, 0)
    name.Color = Color3.fromRGB(255, 255, 255)
    name.Font = 2
    name.Visible = false

    local dist = Drawing.new("Text")
    dist.Size = 12
    dist.Center = true
    dist.Outline = true
    dist.OutlineColor = Color3.fromRGB(0, 0, 0)
    dist.Color = Color3.fromRGB(200, 200, 200)
    dist.Font = 2
    dist.Visible = false

    espCache[player] = { Box = box, Name = name, Dist = dist }
end

local function removeESP(player)
    local data = espCache[player]
    if not data then return end
    if data.Box then data.Box:Remove() end
    if data.Name then data.Name:Remove() end
    if data.Dist then data.Dist:Remove() end
    espCache[player] = nil
end

local function clearAllESP()
    for player, _ in pairs(espCache) do
        removeESP(player)
    end
    espCache = {}
end

local function updateESP()
    if not Camera then return end

    for player, data in pairs(espCache) do
        local char = player.Character
        if not char then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            continue
        end

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")

        if not hrp or not head or not hum or hum.Health <= 0 then
            data.Box.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
            continue
        end

        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local hrpPos, hrpOnScreen = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

        if headOnScreen and hrpOnScreen then
            local height = math.abs(headPos.Y - hrpPos.Y)
            local width = height / 2

            data.Box.Size = Vector2.new(width, height)
            data.Box.Position = Vector2.new(headPos.X - width / 2, headPos.Y)
            data.Box.Visible = true

            data.Name.Text = player.Name
            data.Name.Position = Vector2.new(headPos.X, headPos.Y - 18)
            data.Name.Visible = true

            local distance = (Camera.CFrame.Position - hrp.Position).Magnitude
            data.Dist.Text = string.format("[%d]", math.floor(distance))
            data.Dist.Position = Vector2.new(headPos.X, headPos.Y + height + 2)
            data.Dist.Visible = true
        else
            data.Box.Visible = false
            data.Name.Visible = false
            data.Dist.Visible = false
        end
    end
end

local function startESPRender()
    if renderConnection then return end
    renderConnection = RunService.RenderStepped:Connect(function()
        pcall(updateESP)
    end)
end

local function stopESPRender()
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
end

local function bindPlayerESP(player)
    if player == LocalPlayer then return end

    if espEnabled then
        createESP(player)
    end

    local conn = player.CharacterAdded:Connect(function()
        if espEnabled then
            task.wait(0.5)
            createESP(player)
        end
    end)
    table.insert(playerConnections, conn)
end

for _, player in ipairs(Players:GetPlayers()) do
    bindPlayerESP(player)
end

Players.PlayerAdded:Connect(bindPlayerESP)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

