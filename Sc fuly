                pcall(function()
                    TweenService:Create(frame, TweenInfo.new(1), {
                        BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                    }):Play()
                end)
                task.wait(1)
                if not ScreenCover.Enabled then break end
            end
        end)
        print("Screen Cover: ON")
        return true
    end
end

