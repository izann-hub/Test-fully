-- 🚀 START / STOP FARM
-- ============================================================
local FarmThread = nil

local function StartFarm()
    if FarmRunning then return end
    FarmRunning = true
    FarmCycle = 0
    CurrentStep = "Starting Farm..."
    
    FarmState.ApartmentOwned = false
    FarmState.FirstCycleDone = false
    FarmState.MarshmallowCount = 0
    FarmState.ServiceDone = true
    
    FarmThread = task.spawn(function()
        while FarmRunning do
            FarmCycle = FarmCycle + 1
            local success = false
            pcall(function()
                success = RunFullCycle()
            end)
            if not success then
                print("⚠️ Cycle failed, retrying...")
                task.wait(5)
                FarmCycle = FarmCycle - 1
            end
            task.wait(2)
        end
        CurrentStep = "Idle"
    end)
end

local function StopFarm()
    FarmRunning = false
    FarmState.BikeSitting = false
    CleanupBikeLock()
    if FarmThread then
        pcall(function() task.cancel(FarmThread) end)
        FarmThread = nil
    end
    CurrentStep = "Idle"
end

