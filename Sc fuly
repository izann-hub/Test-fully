            local parent = v.Parent
            if parent and parent:IsA("BasePart") then
                local dist = (parent.Position - targetPos).Magnitude
                if dist < 30 then
                    pcall(function()
                        v.MaxActivationDistance = 9999
                        v.RequiresLineOfSight = false
                        v.HoldDuration = 0.1
                        fireproximityprompt(v)
                    end)
                end
            end
        end
    end
    
    task.wait(0.5)
    return true
end

local function Step11_ATM()
    print("🏧 [11] ATM...")
    CurrentStep = "ATM"
    
    local atm = FindAvailableATMs()
    if not atm then
        print("❌ ATM not found!")
        return false
    end
    
    local attachment = atm:FindFirstChild("Attachment")
    local prompt = attachment and attachment:FindFirstChild("ProximityPrompt")
    if not prompt then
        prompt = atm:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if not prompt then return false end
    
    local atmRoot = atm:FindFirstChild("HumanoidRootPart") or 
                    atm:FindFirstChild("PrimaryPart") or 
                    atm:FindFirstChild("Head")
    if not atmRoot then
        for _, v in pairs(atm:GetChildren()) do
            if v:IsA("BasePart") then
                atmRoot = v
                break
            end
        end
    end
    if not atmRoot then atmRoot = atm end
    
    SafeTeleport(atmRoot.Position + Vector3.new(0, 3, 0), "ATM")
    task.wait(1)
    
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and v.Name:find("Card") then
            EquipTool(v.Name)
            break
        end
    end
    task.wait(0.5)
    
    prompt.MaxActivationDistance = 9999
    prompt.RequiresLineOfSight = false
    prompt.HoldDuration = 0.1
    fireproximityprompt(prompt)
    task.wait(2)
    
    local atmGui = PlayerGui:FindFirstChild("ATM")
    if not atmGui then
        UnequipTools()
        return false
    end
    
    local frame = atmGui:FindFirstChild("Frame")
    local swipeBtn = frame and frame:FindFirstChild("Swipe")
    
    if swipeBtn and swipeBtn:IsA("TextButton") then
        if replicatesignal then
            pcall(function() replicatesignal(swipeBtn.MouseButton1Click) end)
        else
            pcall(function() swipeBtn.MouseButton1Click:Fire() end)
        end
        task.wait(1)
    else
        for _, v in pairs(atmGui:GetDescendants()) do
            if v:IsA("TextButton") then
                local text = v.Text or ""
                if text:find("Swipe") or text:find("SWIPE") then
                    if replicatesignal then
                        pcall(function() replicatesignal(v.MouseButton1Click) end)
                    else
                        pcall(function() v.MouseButton1Click:Fire() end)
                    end
                    task.wait(1)
                    break
                end
            end
        end
    end
    
    UnequipTools()
    return true
end

local function Step12_BuyFakeIDAgain()
    print("🔄 [12] Buy Fake ID Again...")
    CurrentStep = "Buy Fake ID Again"
    
    SafeTeleport(Locations.BuyFakeID, "FakeIDAgain")
    task.wait(1.5)
    
    local seller = nil
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "FakeIDSeller" and v:IsA("Model") then
            seller = v
            break
        end
    end
    
    if seller then
        local prompt = seller:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            FirePrompt(prompt)
            task.wait(2)
            
            local timeout = 0
            while timeout < 5 do
                for _, v in pairs(LP.Backpack:GetChildren()) do
                    if v:IsA("Tool") and (v.Name:find("Fake") or v.Name:find("ID")) then
                        return true
                    end
                end
                task.wait(0.5)
                timeout = timeout + 0.5
            end
        end
    end
    return false
end

local function RunFullCycle()
    print("\n" .. string.rep("=", 50))
    print("🔄 CYCLE " .. FarmCycle .. " START")
    print(string.rep("=", 50))
    
    if not FarmState.FirstCycleDone then
        if not Step1_BuyApartment() then return false end
        FarmState.ApartmentOwned = true
        task.wait(1)
        
        if not Step2_BuyWater() then Step2_BuyWater() end
        task.wait(1)
        
        if not Step3_CookWater() then return false end
        task.wait(1)
        
        if not Step4_BuyFakeID() then Step4_BuyFakeID() end
        task.wait(1)
    else
        print("⏩ Skipping Steps 1-4")
    end
    
    if not Step5_ApplyCard() then return false end
    task.wait(1)
    
    if not Step6_BuyGelatinSugar() then Step6_BuyGelatinSugar() end
    task.wait(1)
    
    if not Step7_CookMarshmallow() then return false end
    FarmState.MarshmallowCount = FarmState.MarshmallowCount + 1
    task.wait(1)
    
    if not Step8_SellMarshmallow() then return false end
    task.wait(1)
    
    if not Step9_BuyWaterAgain() then return false end
    task.wait(1)
    
    if not Step3_CookWater() then return false end
    task.wait(1)
    
    if not Step10_CollectCard() then return false end
    task.wait(1)
    
    if not Step11_ATM() then print("⚠️ ATM failed") end
    task.wait(1)
    
    if not Step12_BuyFakeIDAgain() then Step12_BuyFakeIDAgain() end
    task.wait(1)
    
    FarmState.FirstCycleDone = true
    
    print("✅ CYCLE " .. FarmCycle .. " COMPLETE")
    return true
end

