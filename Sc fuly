    c.Parent = holder

    local s = Instance.new("UIStroke")
    s.Color = accent
    s.Thickness = 1
    s.Transparency = 1
    s.Parent = holder

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 0, 18)
    lbl.Position = UDim2.new(0, 10, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Palette.Light
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTransparency = 1
    lbl.ZIndex = 4
    lbl.Parent = holder

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0, 50, 0, 18)
    valLbl.Position = UDim2.new(1, -58, 0, 6)
    valLbl.BackgroundTransparency = 1
    valLbl.Text = tostring(default)
    valLbl.TextColor3 = accent
    valLbl.TextSize = 13
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.TextTransparency = 1
    valLbl.ZIndex = 4
    valLbl.Parent = holder

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -20, 0, 6)
    bar.Position = UDim2.new(0, 10, 0, 36)
    bar.BackgroundColor3 = Palette.Dark
    bar.BorderSizePixel = 0
    bar.BackgroundTransparency = 1
    bar.ZIndex = 4
    bar.Parent = holder

    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(1, 0)
    bc.Parent = bar

    local pct = (default - min) / (max - min)
    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(pct, 0, 1, 0)
    fill.BackgroundColor3 = accent
    fill.BorderSizePixel = 0
    fill.BackgroundTransparency = 1
    fill.ZIndex = 5
    fill.Parent = bar

    local fc = Instance.new("UICorner")
    fc.CornerRadius = UDim.new(1, 0)
    fc.Parent = fill

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 14, 0, 14)
    thumb.Position = UDim2.new(pct, -7, 0.5, -7)
    thumb.BackgroundColor3 = Palette.White
    thumb.BorderSizePixel = 0
    thumb.BackgroundTransparency = 1
    thumb.ZIndex = 6
    thumb.Parent = bar

    local thc = Instance.new("UICorner")
    thc.CornerRadius = UDim.new(1, 0)
    thc.Parent = thumb

    task.wait(0.03)
    TweenService:Create(holder, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 0}):Play()
    TweenService:Create(s, TweenInfo.new(0.35), {Transparency = 0}):Play()
    TweenService:Create(lbl, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    TweenService:Create(valLbl, TweenInfo.new(0.35), {TextTransparency = 0}):Play()
    TweenService:Create(bar, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()
    TweenService:Create(fill, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()
    TweenService:Create(thumb, TweenInfo.new(0.35), {BackgroundTransparency = 0}):Play()

    holder.MouseEnter:Connect(function()
        TweenService:Create(s, TweenInfo.new(0.15), {Thickness = 2}):Play()
        TweenService:Create(holder, TweenInfo.new(0.15), {BackgroundColor3 = Palette.Hover}):Play()
    end)
    holder.MouseLeave:Connect(function()
        TweenService:Create(s, TweenInfo.new(0.15), {Thickness = 1}):Play()
        TweenService:Create(holder, TweenInfo.new(0.15), {BackgroundColor3 = Palette.DarkGray}):Play()
    end)

    local dragging = false
    local function updateSlider(input)
        local rel = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * rel + 0.5)
        valLbl.Text = tostring(val)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, -7, 0.5, -7)
        if callback then callback(val) end
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 20)
    btn.Position = UDim2.new(0, 0, 0, 30)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 7
    btn.Parent = holder

    btn.MouseButton1Down:Connect(function() dragging = true; updateSlider(UserInputService:GetMouseLocation()) end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then updateSlider(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    return holder
end

