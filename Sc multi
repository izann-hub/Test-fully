local NoClipEnabled = false
local NoClipConnection = nil
local NoClipCharConn = nil
local NoClipDescConn = nil

local function ApplyNoClipToCharacter(char)
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part.CanCollide = false end)
        end
    end
    if NoClipDescConn then NoClipDescConn:Disconnect() end
    NoClipDescConn = char.DescendantAdded:Connect(function(desc)
        if NoClipEnabled and desc:IsA("BasePart") then
            task.wait(0.05)
            pcall(function() desc.CanCollide = false end)
        end
    end)
end

local function EnableNoClipPermanent()
    if NoClipEnabled then return end
    NoClipEnabled = true

    if Player.Character then
        ApplyNoClipToCharacter(Player.Character)
    end

    NoClipConnection = RunService.RenderStepped:Connect(function()
        if not NoClipEnabled then return end
        local char = Player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                pcall(function() part.CanCollide = false end)
            end
        end
    end)

    if NoClipCharConn then NoClipCharConn:Disconnect() end
    NoClipCharConn = Player.CharacterAdded:Connect(function(newChar)
        task.wait(0.5)
        if NoClipEnabled then
            ApplyNoClipToCharacter(newChar)
        end
    end)

    print("🚪 [NOCLIP] Enabled")
end

local function DisableNoClipPermanent()
    if not NoClipEnabled then return end
    NoClipEnabled = false

    if NoClipConnection then NoClipConnection:Disconnect(); NoClipConnection = nil end
    if NoClipCharConn then NoClipCharConn:Disconnect(); NoClipCharConn = nil end
    if NoClipDescConn then NoClipDescConn:Disconnect(); NoClipDescConn = nil end

    pcall(function()
        local char = Player.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.CanCollide = true end)
                end
            end
        end
    end)
    print("🚪 [NOCLIP] Disabled")
end

