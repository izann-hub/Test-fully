-- ===== State =====
local enabled = true
local TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function setSize(px)
    currentSize = math.clamp(math.round(px), SIZE_MIN, SIZE_MAX)
    dotHolder.Size = UDim2.fromOffset(currentSize, currentSize)
    local t = (currentSize - SIZE_MIN) / (SIZE_MAX - SIZE_MIN)
    sizeFill.Size = UDim2.new(t, 0, 1, 0)
    sizeKnob.Position = UDim2.new(t, 0, 0.5, 0)
    sizeValue.Text = currentSize .. "px"
end

local function apply()
    dotHolder.Visible = enabled

    local onColor  = Color3.fromRGB(60, 200, 130)
    local offColor = Color3.fromRGB(90, 90, 100)
    local dotOn    = Color3.fromRGB(80, 230, 140)
    local dotOff   = Color3.fromRGB(255, 110, 110)

    TweenService:Create(sw, TWEEN, {BackgroundColor3 = enabled and onColor or offColor}):Play()
    TweenService:Create(knob, TWEEN, {
        Position = enabled and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    }):Play()
    TweenService:Create(hdrDot, TWEEN, {BackgroundColor3 = enabled and dotOn or dotOff}):Play()
    TweenService:Create(hdrDotGlow, TWEEN, {ImageColor3 = enabled and dotOn or dotOff}):Play()

    status.Text = enabled and "Enabled" or "Disabled"
    status.TextColor3 = enabled and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(200, 150, 150)
end

local function toggle()
    enabled = not enabled
    apply()
end

swBtn.MouseButton1Click:Connect(toggle)
cardBtn.MouseButton1Click:Connect(toggle)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        toggle()
    end
end)

-- ===== Size slider drag =====
local draggingSize = false
sizeBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingSize = true
        local rel = input.Position.X - sizeTrack.AbsolutePosition.X
        local t = math.clamp(rel / sizeTrack.AbsoluteSize.X, 0, 1)
        setSize(SIZE_MIN + t * (SIZE_MAX - SIZE_MIN))
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingSize = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if draggingSize and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local rel = input.Position.X - sizeTrack.AbsolutePosition.X
        local t = math.clamp(rel / sizeTrack.AbsoluteSize.X, 0, 1)
        setSize(SIZE_MIN + t * (SIZE_MAX - SIZE_MIN))
    end
end)

-- ===== Pulse =====
local pulse = 0
RunService.Heartbeat:Connect(function(dt)
    pulse += dt * 3
    local a = 0.25 + math.abs(math.sin(pulse)) * 0.35
    hdrDotGlow.ImageTransparency = enabled and a or 0.9
end)

-- ===== Drag card =====
local dragging, dragStart, startPos
cardBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = card.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        card.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)

-- ===== Init =====
setSize(currentSize)
apply()
