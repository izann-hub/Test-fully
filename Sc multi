-- 6. Kick popup destroyer
task.spawn(function()
    while true do
        pcall(function()
            local CoreGui = game:GetService("CoreGui")
            local LP = game:GetService("Players").LocalPlayer
            local PG = LP and LP:FindFirstChild("PlayerGui")
            local function sweep(container)
                for _, gui in pairs(container:GetChildren()) do
                    local n = gui.Name or ""
                    if n:find("Kick") or n:find("Ban") or n:find("Disconnect")
                    or n:find("Error") or n:find("Moderation") or n:find("Warning")
                    or n:find("Alert") or n:find("Popup") or n:find("Notice")
                    or n:find("Detection") or n:find("Anti") or n:find("Handshake") then
                        gui:Destroy()
                    end
                end
            end
            sweep(CoreGui)
            if PG then sweep(PG) end
        end)
        task.wait(0.1)
    end
end)

