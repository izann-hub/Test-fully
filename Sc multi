-- LocalScript diletakkan di: StarterPlayer > StarterPlayerScripts
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 1. Buat GUI Utama
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "CrosshairToggleUI"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 999
screenGui.Parent = playerGui

-- 2. Crosshair Base (Tengah Layar)
local crosshairBase = Instance.new("Frame")
crosshairBase.Name = "CrosshairBase"
crosshairBase.Size = UDim2.new(0, 100, 0, 100)
crosshairBase.Position = UDim2.new(0.5, -50, 0.5, -50)
crosshairBase.BackgroundTransparency = 1
crosshairBase.Parent = screenGui

-- Fungsi bikin lingkaran crosshair
local function createCircle(name, size, color, transparency)
    local circle = Instance.new("Frame")
    circle.Name = name
    circle.Size = UDim2.new(0, size, 0, size)
    circle.Position = UDim2.new(0.5, -size/2, 0.5, -size/2)
    circle.BackgroundColor3 = color
    circle.BackgroundTransparency = transparency
    circle.BorderSizePixel = 0
    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(1, 0)
    uiCorner.Parent = circle
    circle.Parent = crosshairBase
    return circle
end

-- 3 Layer Glow
createCircle("GlowOuter", 70, Color3.fromHex("#ff99cc"), 0.6)
createCircle("GlowMiddle", 40, Color3.fromHex("#ff66b2"), 0.3)
createCircle("Core", 16, Color3.fromHex("#ffffff"), 0)

-- 3. UI Saklar (Toggle Switch)
local toggleFrame = Instance.new("Frame")
toggleFrame.Name = "ToggleSwitch"
toggleFrame.Size = UDim2.new(0, 60, 0, 30)
toggleFrame.Position = UDim2.new(0, 20, 0.5, -15) -- Kiri tengah layar
toggleFrame.BackgroundColor3 = Color3.fromHex("#444444") -- Off (Abu)
toggleFrame.BorderSizePixel = 0
toggleFrame.Parent = screenGui

local toggleCorner = Instance.new("UICorner")
toggleCorner.CornerRadius = UDim.new(1, 0)
toggleCorner.Parent = toggleFrame

-- Bola Saklar
local toggleBall = Instance.new("Frame")
toggleBall.Name = "ToggleBall"
toggleBall.Size = UDim2.new(0, 26, 0, 26)
toggleBall.Position = UDim2.new(0, 2, 0.5, -13) -- Posisi awal kiri
toggleBall.BackgroundColor3 = Color3.fromHex("#ffffff")
toggleBall.BorderSizePixel = 0
toggleBall.Parent = toggleFrame

local ballCorner = Instance.new("UICorner")
ballCorner.CornerRadius = UDim.new(1, 0)
ballCorner.Parent = toggleBall

-- 4. Logika Saklar
local isOn = true
crosshairBase.Visible = isOn

-- Set posisi awal saklar (On)
toggleBall.Position = UDim2.new(0, 32, 0.5, -13)
toggleFrame.BackgroundColor3 = Color3.fromHex("#ff66b2")

local toggleButton = Instance.new("TextButton")
toggleButton.Name = "ClickArea"
toggleButton.Size = UDim2.new(1, 0, 1, 0)
toggleButton.BackgroundTransparency = 1
toggleButton.Text = ""
toggleButton.Parent = toggleFrame

-- Animasi Tween
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

toggleButton.MouseButton1Click:Connect(function()
    isOn = not isOn
    
    -- Animasi Bola
    local targetPos = isOn and UDim2.new(0, 32, 0.5, -13) or UDim2.new(0, 2, 0.5, -13)
    TweenService:Create(toggleBall, tweenInfo, {Position = targetPos}):Play()
    
    -- Animasi Warna Background
    local targetColor = isOn and Color3.fromHex("#ff66b2") or Color3.fromHex("#444444")
    TweenService:Create(toggleFrame, tweenInfo, {BackgroundColor3 = targetColor}):Play()
    
    -- Toggle Crosshair
    crosshairBase.Visible = isOn
end)
