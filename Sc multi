cardBtn.Text = ""
cardBtn.ZIndex = 9
cardBtn.Parent = card

local enabled = true
local TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function apply()
    crosshair.Visible = enabled

    local onColor  = Color3.fromRGB(60, 200, 130)
    local offColor = Color3.fromRGB(90, 90, 100)
    local dotOn    = Color3.fromRGB(80, 230, 140)
    local dotOff   = Color3.fromRGB(255, 110, 110)

    TweenService:Create(sw, TWEEN, {BackgroundColor3 = enabled and onColor or offColor}):Play()
    TweenService:Create(knob, TWEEN, {
        Position = enabled and UDim2.new(1, -22, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    }):Play()
    TweenService:Create(dot, TWEEN, {BackgroundColor3 = enabled and dotOn or dotOff}):Play()
    TweenService:Create(dotGlow, TWEEN, {ImageColor3 = enabled and dotOn or dotOff}):Play()

    status.Text = enabled and "Enabled" or "Disabled"
    status.TextColor3 = enabled and Color3.fromRGB(240, 240, 245) or Color3.fromRGB(200, 150, 150)
end

local function toggle()
    enabled = not enabled
    apply()
end

swBtn.MouseButton1Click:Connect(toggle)
cardBtn.MouseButton1Click:Connect(toggle)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        toggle()
    end
end)

-- Dot pulse
local pulse = 0
RunService.Heartbeat:Connect(function(dt)
    pulse += dt * 3
    local a = 0.25 + math.abs(math.sin(pulse)) * 0.35
    dotGlow.ImageTransparency = enabled and a or 0.9
end)

-- Drag card
local dragging, dragStart, startPos
cardBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = card.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - dragStart
        card.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)

apply()
