for i, entry in ipairs(palette) do
    local swatch = Instance.new("TextButton")
    swatch.Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE)
    swatch.Position = UDim2.fromOffset(SWATCH_START + (i-1)*(SWATCH_SIZE+SWATCH_GAP), SWATCH_Y)
    swatch.BackgroundColor3 = entry.color
    swatch.BorderSizePixel = 0
    swatch.Text = ""
    swatch.AutoButtonColor = false
    swatch.ZIndex = 12
    swatch.Parent = card

    local sc = Instance.new("UICorner")
    sc.CornerRadius = UDim.new(1, 0)
    sc.Parent = swatch

    local sst = Instance.new("UIStroke")
    sst.Thickness = 1
    sst.Color = Color3.fromRGB(120, 120, 130)
    sst.Transparency = 0.6
    sst.Parent = swatch

    swatchButtons[i] = {button = swatch, stroke = sst, color = entry.color}

    swatch.MouseButton1Click:Connect(function()
        currentColor = entry.color
        dotMain.BackgroundColor3 = entry.color
        local b = entry.color.R + entry.color.G + entry.color.B
        if b > 1.5 then
            dotOutline.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        else
            dotOutline.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        end
        for j, data in ipairs(swatchButtons) do
            if j == i then
                data.stroke.Color = Color3.fromRGB(255, 255, 255)
                data.stroke.Transparency = 0
                data.stroke.Thickness = 2
            else
                data.stroke.Color = Color3.fromRGB(120, 120, 130)
                data.stroke.Transparency = 0.6
                data.stroke.Thickness = 1
            end
        end
    end)
end

