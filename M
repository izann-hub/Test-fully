local function buatPanel(huruf, pos, ukuran)
	local f = Instance.new("Frame")
	f.Name = "Panel" .. huruf
	f.Position = pos + UDim2.fromOffset(0, 20)
	f.Size = ukuran
	f.BackgroundColor3 = TEMA.panel
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = f

	local stroke = Instance.new("UIStroke")
	stroke.Color = TEMA.ungu
	stroke.Thickness = 1
	stroke.Transparency = 0.4
	stroke.Parent = f

	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(34, 34, 44)),
		ColorSequenceKeypoint.new(1, TEMA.panel),
	})
	grad.Parent = f

	local ikon = Instance.new("ImageLabel")
	ikon.Position = UDim2.fromOffset(10, 10)
	ikon.Size = UDim2.fromOffset(20, 20)
	ikon.BackgroundTransparency = 1
	ikon.Image = IKON[huruf]
	ikon.ImageColor3 = TEMA.sian
	ikon.Parent = f

	local judul = Instance.new("TextLabel")
	judul.Position = UDim2.fromOffset(38, 8)
	judul.Size = UDim2.new(1, -48, 0, 24)
	judul.BackgroundTransparency = 1
	judul.Text = huruf
	judul.Font = Enum.Font.GothamBold
	judul.TextSize = 18
	judul.TextColor3 = TEMA.teks
	judul.TextXAlignment = Enum.TextXAlignment.Left
	judul.Parent = f

	local isi = Instance.new("TextLabel")
	isi.Position = UDim2.fromOffset(12, 40)
	isi.Size = UDim2.new(1, -24, 1, -48)
	isi.BackgroundTransparency = 1
	isi.TextXAlignment = Enum.TextXAlignment.Left
	isi.TextYAlignment = Enum.TextYAlignment.Top
	isi.Font = Enum.Font.Gotham
	isi.TextSize = ukuranAktif
	isi.TextColor3 = TEMA.redup
	isi.TextWrapped = true
	isi.LineHeight = 1.2
	isi.Text = ""
	isi.Parent = f

	table.insert(daftarIsi, isi)

	TweenService:Create(f, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0,
		Position = pos,
	}):Play()

	return f
end

