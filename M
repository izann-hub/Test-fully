-- ============================================
-- 2. SISTEM HUJAN SALJU
-- ============================================
local snowContainer = Instance.new("Frame")
snowContainer.Size = UDim2.fromScale(1, 1)
snowContainer.BackgroundTransparency = 1
snowContainer.ZIndex = 4
snowContainer.Parent = SG

local snowActive = true

local function spawnSnow()
	if not snowActive then return end
	
	local snow = Instance.new("Frame")
	snow.Size = UDim2.fromOffset(math.random(3, 6), math.random(3, 6))
	snow.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	snow.BackgroundTransparency = math.random(20, 60) / 100
	snow.BorderSizePixel = 0
	snow.Position = UDim2.new(math.random(), 0, -0.05, 0)
	snow.ZIndex = 5
	snow.Parent = snowContainer
	
	Instance.new("UICorner", snow).CornerRadius = UDim.new(1, 0)
	
	local fallDuration = math.random(5, 10)
	local drift = math.random(-50, 50) / 1000
	local targetPos = UDim2.new(snow.Position.X.Scale + drift, 0, 1.05, 0)
	
	local tween = TweenService:Create(snow, TweenInfo.new(fallDuration, Enum.EasingStyle.Linear), {Position = targetPos})
	tween:Play()
	
	tween.Completed:Connect(function()
		snow:Destroy()
	end)
end

task.spawn(function()
	while snowActive do
		spawnSnow()
		task.wait(math.random(5, 15) / 100) 
	end
end)

