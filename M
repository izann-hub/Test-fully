local tabItems = {}
local activeTab = 1
local function buatTabItem(label, index, onClick)
    local y = TAB_PAD + (index - 1) * (TAB_ITEM_H + TAB_GAP)
    local btn = Instance.new("TextButton", sidebar) btn.Size = UDim2.new(0, TAB_ITEM_W, 0, TAB_ITEM_H) btn.Position = UDim2.new(0, (SIDEBAR_W - TAB_ITEM_W) / 2, 0, y) btn.BackgroundColor3 = C.TRANSPARENT btn.BackgroundTransparency = 1 btn.Text = label btn.TextColor3 = C.TEXT_DIM btn.Font = Enum.Font.GothamMedium btn.TextSize = 11 btn.AutoButtonColor = false btn.ZIndex = 28 btn.Active = true
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local isActive = false
    btn.MouseEnter:Connect(function() if not isActive then btn.BackgroundTransparency = 0 TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.SURFACE_HI, TextColor3 = C.TEXT }):Play() end end)
    btn.MouseLeave:Connect(function() if not isActive then TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = C.TRANSPARENT, TextColor3 = C.TEXT_DIM }):Play() end end)
    btn.MouseButton1Down:Connect(function() playClick() onClick(index) end) 
    return {
        btn = btn,
        setActive = function(a)
            isActive = a
            btn.BackgroundTransparency = a and 0 or 1
            TweenService:Create(btn, TweenInfo.new(0.2), { BackgroundColor3 = a and C.SURFACE_HI or C.TRANSPARENT, TextColor3 = a and C.ACCENT or C.TEXT_DIM }):Play()
            btn.Font = a and Enum.Font.GothamBold or Enum.Font.GothamMedium
        end,
        getY = function() return y + TAB_ITEM_H / 2 end,
    }
end

local function staggerReveal(page)
    task.spawn(function()
        for _, c in ipairs(page:GetChildren()) do
            if c:IsA("Frame") or c:IsA("TextButton") then
                local origTrans = c.BackgroundTransparency
                c.BackgroundTransparency = 1
                task.wait(0.04)
                TweenService:Create(c, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = origTrans }):Play() 
            end
        end
    end)
end

local function switchTab(index)
    if index == activeTab then return end
    activeTab = index
    for i, it in ipairs(tabItems) do it.setActive(i == index) end
    local targetY = tabItems[index].getY() - 11
    TweenService:Create(accentBar, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 4, 0, targetY) }):Play()
    
    homePage.Visible = (index == 1)
    warPage.Visible = (index == 2)
    fpsPage.Visible = (index == 3)
    
    if index == 1 then staggerReveal(homePage)
    elseif index == 2 then staggerReveal(warPage)
    else staggerReveal(fpsPage) end
end

