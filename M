-- 4. ANIMASI MASUK & TUTUP (CLEANUP SEMPURNA)
-- ============================================
task.wait(0.1)
TweenService:Create(card, 
	TweenInfo.new(0.8, Enum.EasingStyle.Back, Enum.EasingDirection.Out), 
	{Position = UDim2.new(0.5, 0, 0.5, 0)}
):Play()

local closing = false
local function closeUI()
	if closing then return end
	closing = true
	snowActive = false 

	local fadeTweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Linear)
	
	TweenService:Create(bgImage, fadeTweenInfo, {ImageTransparency = 1}):Play()
	TweenService:Create(overlay, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
	TweenService:Create(card, fadeTweenInfo, {BackgroundTransparency = 1}):Play()

	for _, obj in ipairs(card:GetDescendants()) do
		if obj:IsA("ImageLabel") then
			TweenService:Create(obj, fadeTweenInfo, {ImageTransparency = 1}):Play()
		elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
			TweenService:Create(obj, fadeTweenInfo, {TextTransparency = 1, BackgroundTransparency = 1}):Play()
		elseif obj:IsA("Frame") then
			TweenService:Create(obj, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
		end
	end

	for _, obj in ipairs(snowContainer:GetChildren()) do
		if obj:IsA("Frame") then
			TweenService:Create(obj, fadeTweenInfo, {BackgroundTransparency = 1}):Play()
		end
	end

	TweenService:Create(winterSound, TweenInfo.new(1), {Volume = 0}):Play()
	TweenService:Create(blur, TweenInfo.new(1), {Size = 0}):Play()
	
	if connection then
		connection:Disconnect()
	end

	task.wait(1)
	
	winterSound:Stop()
	winterSound:Destroy()
	blur:Destroy()
	SG:Destroy()
end

-- ============================================
-- 5. FUNGSI EKSEKUSI SCRIPT DARI GITHUB
-- ============================================
local SCRIPT_URL = "https://raw.githubusercontent.com/izann-hub/THB-FULLY/refs/heads/main/Fully"

local function executeScript()
	closeUI() 
	
	task.spawn(function()
		local success, err = pcall(function()
			local scriptContent = game:HttpGet(SCRIPT_URL)
			local func = loadstring(scriptContent)
			if func then
				func()
			else
				warn("Gagal melakukan loadstring pada script.")
			end
		end)
		
		if not success then
			warn("Gagal mengeksekusi script dari URL: " .. tostring(err))
		end
	end)
end

enterBtn.Activated:Connect(executeScript)
closeBtn.Activated:Connect(closeUI)
