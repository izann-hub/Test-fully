local function buatTombolBawah(teks, xOffset, target)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(130, 36)
	btn.Position = UDim2.new(1, xOffset, 1, -50)
	btn.BackgroundColor3 = TEMA.panel
	btn.BorderSizePixel = 0
	btn.Text = teks
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	btn.TextColor3 = TEMA.teks
	btn.Parent = gui
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
	local s = Instance.new("UIStroke"); s.Color = TEMA.ungu; s.Thickness = 1; s.Transparency = 0.3; s.Parent = btn
	btn.MouseButton1Click:Connect(function()
		if rondeSelesai then return end
		target.Visible = not target.Visible
	end)
