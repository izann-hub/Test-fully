-- SAFE GUN LOGIC (NO RECOIL)
-- ============================================================
local function applyGunMods()
    local function processTool(child)
        if child:IsA("Tool") then
            local settingModule = child:FindFirstChild("Setting")
            if settingModule and settingModule:IsA("ModuleScript") then
                local success, settings = pcall(require, settingModule)
                if success and type(settings) == "table" then
                    if not defaultSettings[child.Name] then
                        defaultSettings[child.Name] = {
                            Recoil = settings.Recoil or 0, 
                            CameraRecoil = settings.CameraRecoil or 0
                        }
                    end
                    local def = defaultSettings[child.Name]

                    if state.zeroRecoil then 
                        pcall(function() settings.Recoil = 0; settings.CameraRecoil = 0 end)
                    else 
                        pcall(function() settings.Recoil = def.Recoil; settings.CameraRecoil = def.CameraRecoil end) 
                    end
                end
            end
        end
    end

    local char = localPlayer.Character
    local bp = localPlayer:FindFirstChild("Backpack")
    if char then for _, child in ipairs(char:GetChildren()) do processTool(child) end end
    if bp then for _, child in ipairs(bp:GetChildren()) do processTool(child) end end
end

-- Safe Loop (Jeda Acak biar ga ketahuan anti-cheat)
task.spawn(function()
    while task.wait(math.random(80, 120) / 100) do
        if state.zeroRecoil then applyGunMods() end
    end
end)

local function hookCharacter(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then task.wait(0.1) applyGunMods() end
    end)
end
if localPlayer.Character then hookCharacter(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(hookCharacter)

