        BtnToggle.Text = "STOP AUTO FARM"
        BtnToggle.BackgroundColor3 = MERAH_TUA
        SendNotification("JENOWA STORE", "Auto Farm Started", 2)
        RunAutoFarmSequence()
    else
        BtnToggle.Text = "START AUTO FARM"
