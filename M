local function AmbilOwnership()
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function() part:SetNetworkOwner(player) end)
        end
    end
end

local function TungguHumanoidSiap()
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local timeout = 0
    while timeout < 2 do
        if not hum.PlatformStand and hum:GetState() ~= Enum.HumanoidStateType.Jumping and hum:GetState() ~= Enum.HumanoidStateType.Freefall then
            break
        end
        task.wait(0.1)
        timeout = timeout + 0.1
    end
end

local function GoDownSmooth()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp or not hum then return end

    if not savedSurfaceCF then savedSurfaceCF = hrp.CFrame end

    AmbilOwnership()
    hum.PlatformStand = true
    hrp.Anchored = true

    local targetCF = savedSurfaceCF - Vector3.new(0, PLATFORM_HEIGHT, 0)
    local tween = TweenService:Create(hrp, TweenInfo.new(TWEEN_TIME_DOWN, Enum.EasingStyle.Linear), { CFrame = targetCF })
    tween:Play()
    tween.Completed:Wait()

    char:PivotTo(targetCF)
    hrp.Anchored = false
    hum.PlatformStand = false
end

local function GoUpSmooth()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hrp or not hum then return end

    if savedSurfaceCF then
        hum.PlatformStand = true
        hrp.Anchored = true

        local tween = TweenService:Create(hrp, TweenInfo.new(TWEEN_TIME_UP, Enum.EasingStyle.Linear), { CFrame = savedSurfaceCF })
        tween:Play()
        tween.Completed:Wait()

        char:PivotTo(savedSurfaceCF)
        hrp.Anchored = false
        hum.PlatformStand = false
    end
end

local function BuatPlatform()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local platform = Instance.new("Part")
    platform.Name = "JenowaPlatform"
    platform.Size = Vector3.new(10, 1, 10)
    platform.Position = hrp.Position - Vector3.new(0, 4, 0)
    platform.Anchored = true
    platform.CanCollide = true
    platform.Material = Enum.Material.Neon
    platform.Color = MERAH
    platform.Parent = workspace

    local highlight = Instance.new("Highlight")
    highlight.FillColor = MERAH_TERANG
    highlight.OutlineColor = PUTIH
    highlight.FillTransparency = 0.7
    highlight.Parent = platform

    return platform
end

local function PlatformDown(platform, meter)
    if not platform then return end
    local tween = TweenService:Create(platform, TweenInfo.new(TWEEN_TIME_DOWN, Enum.EasingStyle.Linear), { Position = platform.Position - Vector3.new(0, meter, 0) })
    tween:Play()
    tween.Completed:Wait()
end

local function PlatformUp(platform, meter)
    if not platform then return end
    local tween = TweenService:Create(platform, TweenInfo.new(TWEEN_TIME_UP, Enum.EasingStyle.Linear), { Position = platform.Position + Vector3.new(0, meter, 0) })
    tween:Play()
    tween.Completed:Wait()
end

-- ============================================
-- 🔄 AUTO FARM SEQUENCE
-- ============================================
local function RunAutoFarmSequence()
    task.spawn(function()
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then
            SendNotification("Error", "Character not found", 3)
            return
        end

        savedSurfaceCF = hrp.CFrame
        local platform = BuatPlatform()
        currentPlatform = platform

        while farmActive do
            StatusLabel.Text = "🔥 Water..."
            StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
            if not EquipItemWithRetry(WATER, 3) then break end
            if not farmActive then break end
            PressKeyThreeTimes(actionKey)
            task.wait(0.5)

            PlatformDown(platform, PLATFORM_HEIGHT)
            GoDownSmooth()
            if not farmActive then break end

            local waitTime1 = 0
            while farmActive and waitTime1 < 20 do
                task.wait(1)
                waitTime1 = waitTime1 + 1
                ProgressFill.Size = UDim2.new(waitTime1 / 20, 0, 1, 0)
            end
            if not farmActive then break end

            GoUpSmooth()
            PlatformUp(platform, PLATFORM_HEIGHT)
            TungguHumanoidSiap()
            task.wait(1)
            if not farmActive then break end

            StatusLabel.Text = "🔥 Sugar..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
            if not EquipItemWithRetry(SUGAR_BLOCK, 5) then break end
            if not farmActive then break end
            task.wait(0.3)
            PressKeyThreeTimes(actionKey)
            task.wait(0.5)

            local waitTime2 = 0
            while farmActive and waitTime2 < 1 do
                task.wait(0.2)
                waitTime2 = waitTime2 + 0.2
            end
            if not farmActive then break end

            StatusLabel.Text = "🔥 Gelatin..."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 150, 255)
            if not EquipItemWithRetry(GELATIN, 5) then break end
            if not farmActive then break end
            task.wait(0.3)
            PressKeyThreeTimes(actionKey)
            task.wait(0.5)

            PlatformDown(platform, PLATFORM_HEIGHT)
            GoDownSmooth()
            if not farmActive then break end

            local waitTime3 = 0
            while farmActive and waitTime3 < 45 do
                task.wait(1)
                waitTime3 = waitTime3 + 1
                ProgressFill.Size = UDim2.new(waitTime3 / 45, 0, 1, 0)
            end
            if not farmActive then break end

            GoUpSmooth()
            PlatformUp(platform, PLATFORM_HEIGHT)
            TungguHumanoidSiap()
            task.wait(1)
            if not farmActive then break end

            StatusLabel.Text = "🔥 Empty Bag..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
            if not EquipItemWithRetry(EMPTY_BAG, 5) then break end
            if not farmActive then break end
            task.wait(0.3)
            PressKeyThreeTimes(actionKey)
            task.wait(0.5)

            StatusLabel.Text = "✅ Cycle Complete"
            StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
            ProgressFill.Size = UDim2.new(1, 0, 1, 0)
            task.wait(1)
            ProgressFill.Size = UDim2.new(0, 0, 1, 0)
        end

        GoUpSmooth()
        if platform then
            platform:Destroy()
            currentPlatform = nil
        end

        farmActive = false
        BtnToggle.Text = "START AUTO FARM"
        BtnToggle.BackgroundColor3 = MERAH
        StatusLabel.Text = "Idle"
        StatusLabel.TextColor3 = PUTIH
        ProgressFill.Size = UDim2.new(0, 0, 1, 0)
    end)
end

BtnToggle.MouseButton1Click:Connect(function()
