local function perbaruiRiwayat()
	for i = 1, 5 do
		local e = riwayat[i]
		if e then
			barisRiwayat[i].Text = "Ketuk " .. e.ketuk .. " | " .. e.hasil
			barisRiwayat[i].TextColor3 = e.hasil == "Lolos" and TEMA.sian or TEMA.merah
		else
			barisRiwayat[i].Text = "-"
			barisRiwayat[i].TextColor3 = TEMA.redup
		end
	end
end

