local function buatTombol(parent, teks, y, tinggi, font)
	local btn = Instance.new("TextButton")
	btn.Position = UDim2.fromOffset(20, y)
	btn.Size = UDim2.fromOffset(240, tinggi)
	btn.BackgroundColor3 = TEMA.latar
	btn.BorderSizePixel = 0
	btn.Text = teks
	btn.Font = font or Enum.Font.Gotham
	btn.TextSize = 14
	btn.TextColor3 = TEMA.redup
	btn.AutoButtonColor = false
	btn.Parent = parent
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 8); c.Parent = btn
	local st = Instance.new("UIStroke"); st.Color = TEMA.redup; st.Thickness = 1; st.Transparency = 0.5; st.Parent = btn
	btn.UIStroke = st
	return btn
end

for i, p in ipairs(PILIHAN_FONT) do
	local btn = buatTombol(setting, p.nama, 38 + (i - 1) * 38, 32, p.font)
	tombolFont[p.nama] = btn
	btn.MouseButton1Click:Connect(function()
		if rondeSelesai then return end
		fontAktif = p.nama
		terapkanFont()
	end)
end

