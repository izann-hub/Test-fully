--[[
    MasterUI + Gameplay Gepeng + Optimizer (NO FOG)
    Parent: StarterPlayer > StarterPlayerScripts
    Nama: MasterUI
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local SoundService = game:GetService("SoundService")
local player = Players.LocalPlayer

-- ============================================================
-- TAKARAN
-- ============================================================
local ACCENT = Color3.fromRGB(0, 255, 200)
local BG_TOP = Color3.fromRGB(10, 10, 15)
local BG_BOT = Color3.fromRGB(20, 20, 30)
local TEXT_C = Color3.fromRGB(255, 255, 255)

local MAX_DISTANCE = 300
local MIN_PART_SIZE = 0.5
local CULL_INTERVAL = 2
local BAR_RATIO = 0.2

local FONTS = {
    Enum.Font.Gotham, Enum.Font.GothamBold, Enum.Font.GothamBlack,
    Enum.Font.SourceSans, Enum.Font.SourceSansBold, Enum.Font.Code,
    Enum.Font.Roboto, Enum.Font.Antique, Enum.Font.Arcade, Enum.Font.Fantasy,
    Enum.Font.SciFi, Enum.Font.Bangers, Enum.Font.Creepster,
    Enum.Font.LuckiestGuy, Enum.Font.PermanentMarker, Enum.Font.Ubuntu,
}
local fontIndex = 1

-- ============================================================
-- BAGIAN 1: GAMEPLAY GEPENG
-- ============================================================
local function applyFlatten()
    local guiGepeng = Instance.new("ScreenGui")
    guiGepeng.Name = "GameplayGepeng"
    guiGepeng.IgnoreGuiInset = true
    guiGepeng.ResetOnSpawn = false
    guiGepeng.DisplayOrder = 999
    guiGepeng.Parent = player:WaitForChild("PlayerGui")

    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, BAR_RATIO, 0)
    topBar.Position = UDim2.new(0, 0, 0, 0)
    topBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    topBar.BorderSizePixel = 0
    topBar.Parent = guiGepeng

    local botBar = Instance.new("Frame")
    botBar.Size = UDim2.new(1, 0, BAR_RATIO, 0)
    botBar.Position = UDim2.new(0, 0, 1 - BAR_RATIO, 0)
    botBar.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    botBar.BorderSizePixel = 0
    botBar.Parent = guiGepeng
end

-- ============================================================
-- BAGIAN 2: OPTIMIZER (TANPA KABUT)
-- ============================================================
local function runOptimizer()
    -- Matikan kabut total
    Lighting.FogEnd = 100000
    Lighting.FogStart = 0
    Lighting.GlobalShadows = false
    Lighting.ShadowSoftness = 0
    Lighting.Brightness = 1
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.OutdoorAmbient = Color3.fromRGB(80, 80, 80)

    local terrain = Workspace:FindFirstChildOfClass("Terrain")
    if terrain then
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
    end

    local function optimizePart(part)
        if not part:IsA("BasePart") then return end
        if part.Transparency >= 1 and not part:IsA("MeshPart") then
            part:Destroy() return
        end
        if part.CanCollide == false and part.Size.Magnitude < MIN_PART_SIZE then
            part:Destroy() return
        end
        part.CastShadow = false
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        optimizePart(obj)
    end

    pcall(function() Workspace.StreamingEnabled = true end)

    task.spawn(function()
        while task.wait(CULL_INTERVAL) do
            local cam = Workspace.CurrentCamera
            if cam then
                local camPos = cam.CFrame.Position
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        local dist = (obj.Position - camPos).Magnitude
                        obj.LocalTransparencyModifier = (dist > MAX_DISTANCE) and 1 or 0
                    end
                end
            end
        end
    end)

    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    SoundService.RespectFilteringEnabled = true
end

-- ============================================================
-- BAGIAN 3: UI BARU
-- ============================================================
local function buildUI()
    local gui = Instance.new("ScreenGui")
    gui.Name = "MasterUI"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000
    gui.Parent = player:WaitForChild("PlayerGui")

    local main = Instance.new("Frame")
    main.Name = "MainFrame"
    main.Size = UDim2.new(0, 260, 0, 240)
    main.AnchorPoint = Vector2.new(0.5, 0.5)
    main.Position = UDim2.new(0.5, 0, 0.6, 0)
    main.BackgroundColor3 = BG_TOP
    main.BorderSizePixel = 0
    main.Parent = gui

    Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", main)
    stroke.Thickness = 2
    stroke.Color = ACCENT
    stroke.Transparency = 0.3

    local grad = Instance.new("UIGradient", main)
    grad.Rotation = 45
    grad.Color = ColorSequence.new(BG_TOP, BG_BOT)

    local pad = Instance.new("UIPadding", main)
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)

    local tLabel = Instance.new("TextLabel")
    tLabel.Size = UDim2.new(1, -35, 0, 30)
    tLabel.BackgroundTransparency = 1
    tLabel.Text = "SYSTEM MENU"
    tLabel.TextColor3 = ACCENT
    tLabel.Font = Enum.Font.GothamBold
    tLabel.TextSize = 16
    tLabel.TextXAlignment = Enum.TextXAlignment.Left
    tLabel.Parent = main

    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 30, 0, 30)
    close.Position = UDim2.new(1, -30, 0, 0)
    close.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
    close.Text = "X"
    close.TextColor3 = Color3.fromRGB(255,255,255)
    close.Font = Enum.Font.GothamBold
    close.TextSize = 14
    close.Parent = main
    Instance.new("UICorner", close).CornerRadius = UDim.new(0, 6)

    close.MouseButton1Click:Connect(function()
        TweenService:Create(main, TweenInfo.new(0.2), {Size = UDim2.new(0,0,0,0)}):Play()
    end)

    local list = Instance.new("Frame")
    list.Size = UDim2.new(1, 0, 1, -35)
    list.Position = UDim2.new(0, 0, 0, 35)
    list.BackgroundTransparency = 1
    list.Parent = main

    local layout = Instance.new("UIListLayout", list)
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local trackedTexts = {tLabel}

    local function applyFont(fontEnum)
        for _, obj in ipairs(trackedTexts) do
            if obj and obj.Parent then obj.Font = fontEnum end
        end
    end

    local function makeButton(text, order, isAccent)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 38)
        btn.BackgroundColor3 = isAccent and ACCENT or Color3.fromRGB(25, 25, 35)
        btn.Text = "  " .. text
        btn.TextColor3 = isAccent and Color3.fromRGB(0,0,0) or TEXT_C
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 14
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.LayoutOrder = order
        btn.Parent = list

        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
        if not isAccent then
            local s = Instance.new("UIStroke", btn)
            s.Thickness = 1
            s.Color = Color3.fromRGB(50, 50, 70)
        end

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = isAccent and Color3.fromRGB(0, 200, 150) or Color3.fromRGB(40, 40, 60)
            }):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = isAccent and ACCENT or Color3.fromRGB(25, 25, 35)
            }):Play()
        end)

        table.insert(trackedTexts, btn)
        return btn
    end

    makeButton("📦 Item Arsenal", 1, false)
    makeButton("📖 Novel Archive", 2, false)
    makeButton("⚙️ Settings", 3, false)

    local fontBtn = makeButton("🔤 Font: Gotham", 4, true)

    fontBtn.MouseButton1Click:Connect(function()
        fontIndex = fontIndex + 1
        if fontIndex > #FONTS then fontIndex = 1 end
        local f = FONTS[fontIndex]
        applyFont(f)
        fontBtn.Text = "  🔤 Font: " .. f.Name
    end)

    main.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 260, 0, 240)
    }):Play()
end

-- ============================================================
-- JALANKAN
-- ============================================================
runOptimizer()
applyFlatten()
buildUI()

print("[MasterUI] Kabut dihapus. Semua valid.")
