-- ===== SUARA =====
local function bunyi(id, vol)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. id
	s.Volume = vol or 0.5
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 2)
end

-- ===== ANIMASI =====
local function animasiAngka(label)
	label.TextSize = ukuranAktif + 4
	TweenService:Create(label, TweenInfo.new(0.15), { TextSize = ukuranAktif }):Play()
end

local function kedipMerah(frame)
	for _ = 1, 3 do
		frame.BackgroundColor3 = TEMA.merah
		task.wait(0.12)
		frame.BackgroundColor3 = TEMA.panel
		task.wait(0.12)
	end
end

-- ===== UPDATE DARI SERVER =====
updateUI.OnClientEvent:Connect(function(data)
	if data.peringatan then
		local p = data.peringatan
		peringatan.Visible = true
		ps.Color = p.jenis == "curang" and TEMA.merah or TEMA.sian
		pJudul.TextColor3 = p.jenis == "curang" and TEMA.merah or TEMA.sian
		pIsi.Text = p.pesan or ""
		return
	end

	panelJ.Isi.Text = "Jalur: 20 part\nBuntu: " .. table.concat(data.buntu, ", ")
	panelW.Isi.Text = "Ketuk: " .. data.ketuk
	panelS.Isi.Text = "Pelari: " .. data.pelari .. "\nPengejar: " .. data.pengejar
	panelR.Isi.Text = "1 Genangan\n2 Pintu\n3 Gelap"

	animasiAngka(panelW.Isi)

	if data.selesai and not rondeSelesai then
		rondeSelesai = true
		setting.Visible = false
		local hasil = (data.pelari >= 20) and "Lolos" or "Tertangkap"
		panelS.Isi.Text = panelS.Isi.Text .. "\n" .. string.upper(hasil)
		panelS.Isi.TextColor3 = hasil == "Lolos" and TEMA.sian or TEMA.merah
		kedipMerah(panelS)
		bunyi(hasil == "Lolos" and "9118823104" or "9118824052", 0.6)
		table.insert(riwayat, 1, { ketuk = data.ketuk, hasil = hasil })
		if #riwayat > 5 then table.remove(riwayat) end
		perbaruiRiwayat()
	end
end)

-- ===== HEARTBEAT & ANTI-KICK =====
task.spawn(function()
	while true do
		task.wait(2)
		Heartbeat:FireServer(os.clock())
		if os.clock() - heartbeatTerakhir > 5 then
			heartbeatGagal += 1
			if heartbeatGagal >= 3 then
				peringatan.Visible = true
				ps.Color = TEMA.sian
				pJudul.TextColor3 = TEMA.sian
				pIsi.Text = "Koneksi bermasalah. Menunggu server..."
				heartbeatGagal = 0
			end
		else
			heartbeatGagal = 0
		end
	end
end)

Heartbeat.OnClientEvent:Connect(function()
	heartbeatTerakhir = os.clock()
end)

Players.PlayerRemoving:Connect(function(p)
	if p == player and not rondeSelesai then
		table.insert(logKick, 1, os.time())
		ValidasiAksi:FireServer("kick_report")
	end
end)

