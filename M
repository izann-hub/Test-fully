local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- 0. BERSIHKAN UI & SUARA LAMA
for _, gui in ipairs(playerGui:GetChildren()) do
	if gui:IsA("ScreenGui") and (gui.Name == "JenowaStoreUI" or gui.Name:find("Jenowa")) then
		gui:Destroy()
	end
end
for _, sound in ipairs(SoundService:GetChildren()) do
	if sound.Name == "WinterAmbient" then
		sound:Destroy()
	end
end
for _, effect in ipairs(Lighting:GetChildren()) do
	if effect:IsA("BlurEffect") and effect.Name == "JenowaBlur" then
		effect:Destroy()
	end
end

local SG = Instance.new("ScreenGui")
SG.Name = "JenowaStoreUI"
SG.ResetOnSpawn = false
SG.IgnoreGuiInset = true
SG.DisplayOrder = 9999
SG.Parent = playerGui

-- ============================================
-- 0.5 SUARA ANGIN DINGIN
-- ============================================
local winterSound = Instance.new("Sound")
winterSound.Name = "WinterAmbient"
winterSound.SoundId = "rbxassetid://1838865396" 
winterSound.Volume = 0
winterSound.Looped = true
winterSound.Parent = SoundService

local function forcePlaySound()
	if winterSound and winterSound.Parent then
		if not winterSound.IsPlaying then
			winterSound:Play()
		end
		TweenService:Create(winterSound, TweenInfo.new(2), {Volume = 0.5}):Play()
	end
end

task.spawn(function()
	pcall(function()
		winterSound:Play()
		TweenService:Create(winterSound, TweenInfo.new(2), {Volume = 0.5}):Play()
	end)
end)

local connection
connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not gameProcessed then
		forcePlaySound()
		if connection then
			connection:Disconnect()
		end
	end
end)

