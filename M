local function applyPostEffects(v) pcall(function() for _, p in ipairs(Lighting:GetChildren()) do if p:IsA("PostEffect") then p.Enabled = not v end end end) end
local function applyShadows(v) pcall(function() Lighting.GlobalShadows = not v end) end
local function applyMaterials(v)
    task.spawn(function()
        local c = 0
        for _, inst in ipairs(workspace:GetDescendants()) do
            if inst:IsA("BasePart") and not (localPlayer.Character and inst:IsDescendantOf(localPlayer.Character)) then
                if v then
                    if not originalData.parts[inst] then originalData.parts[inst] = { Material = inst.Material, Reflectance = inst.Reflectance } end
                    pcall(function() inst.Material = Enum.Material.SmoothPlastic inst.Reflectance = 0 end)
                elseif originalData.parts[inst] then
                    pcall(function() inst.Material = originalData.parts[inst].Material inst.Reflectance = originalData.parts[inst].Reflectance end)
                end
                c = c + 1
                if c % 50 == 0 then task.wait() end
            end
        end
    end)
end
local function applyDecals(v)
    task.spawn(function()
        local c = 0
        for _, inst in ipairs(workspace:GetDescendants()) do
            if (inst:IsA("Texture") or inst:IsA("Decal")) and not (localPlayer.Character and inst:IsDescendantOf(localPlayer.Character)) then
                if v then
                    if not originalData.decals[inst] then originalData.decals[inst] = inst.Transparency end
                    pcall(function() inst.Transparency = 1 end)
                elseif originalData.decals[inst] then
                    pcall(function() inst.Transparency = originalData.decals[inst] end)
                end
                c = c + 1
                if c % 50 == 0 then task.wait() end
            end
        end
    end)
end
local function applyTerrain(v)
    pcall(function()
        local t = workspace:FindFirstChild("Terrain") if not t then return end
        if v then
            if not originalData.terrain[1] then originalData.terrain = {t.WaterWaveSize, t.WaterWaveSpeed, t.WaterReflectance, t.WaterTransparency} end
            t.WaterWaveSize = 0 t.WaterWaveSpeed = 0 t.WaterReflectance = 0 t.WaterTransparency = 1
        elseif originalData.terrain[1] then
            t.WaterWaveSize = originalData.terrain[1] t.WaterWaveSpeed = originalData.terrain[2] t.WaterReflectance = originalData.terrain[3] t.WaterTransparency = originalData.terrain[4]
        end
    end)
end
local function applyQuality(v) pcall(function() settings().Rendering.QualityLevel = v end) end
local function applyMorning(v)
    pcall(function()
        if v then
            if not morningSnapshot then
                local a = Lighting:FindFirstChildOfClass("Atmosphere")
                local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
                morningSnapshot = {Lighting.ClockTime, Lighting.Brightness, Lighting.Ambient, Lighting.OutdoorAmbient, Lighting.FogEnd, Lighting.FogStart, Lighting.FogColor, a and a.Density, a and a.Haze, a and a.Glare, cc and cc.TintColor}
            end
            Lighting.ClockTime = 6.5 Lighting.Brightness = 2 Lighting.Ambient = Color3.fromRGB(70, 75, 85) Lighting.OutdoorAmbient = Color3.fromRGB(128, 140, 160) Lighting.FogStart = 0 Lighting.FogEnd = 2000 Lighting.FogColor = Color3.fromRGB(200, 215, 230)
            local a = Lighting:FindFirstChildOfClass("Atmosphere") if a then a.Density = 0.3 a.Haze = 1 a.Glare = 0 end
            local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") if cc then cc.TintColor = Color3.fromRGB(255, 240, 220) end
        elseif morningSnapshot then
            local s = morningSnapshot
            Lighting.ClockTime = s[1] Lighting.Brightness = s[2] Lighting.Ambient = s[3] Lighting.OutdoorAmbient = s[4] Lighting.FogStart = s[6] Lighting.FogEnd = s[5] Lighting.FogColor = s[7]
            local a = Lighting:FindFirstChildOfClass("Atmosphere") if a and s[8] then a.Density = s[8] a.Haze = s[9] a.Glare = s[10] end
            local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") if cc and s[11] then cc.TintColor = s[11] end
        end
    end)
end

