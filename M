-- ===== TERAPKAN FONT =====
local tombolFont, tombolUkuran = {}, {}

local function terapkanFont()
	for _, isi in ipairs(daftarIsi) do
		for _, p in ipairs(PILIHAN_FONT) do
			if p.nama == fontAktif then isi.Font = p.font end
		end
		isi.TextSize = ukuranAktif
	end
	for nama, btn in pairs(tombolFont) do
		local aktif = (nama == fontAktif)
		btn.UIStroke.Color = aktif and TEMA.sian or TEMA.redup
		btn.UIStroke.Transparency = aktif and 0 or 0.5
		btn.TextColor3 = aktif and TEMA.sian or TEMA.redup
	end
	for i, btn in pairs(tombolUkuran) do
		local aktif = (PILIHAN_UKURAN[i].nilai == ukuranAktif)
		btn.UIStroke.Color = aktif and TEMA.sian or TEMA.redup
		btn.UIStroke.Transparency = aktif and 0 or 0.5
		btn.TextColor3 = aktif and TEMA.sian or TEMA.redup
	end
end

